--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/mod.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp3/mod.rs	2026-11-02 17:20:41.964167956 -0700
@@ -0,0 +1,10 @@
+//! MP3 container (MPEG audio elementary stream with ID3 tags).
+//!
+//! See `docs/MP3_MP4.md` for the format walkthrough.
+
+pub mod demuxer;
+pub mod id3;
+pub mod muxer;
+pub mod probe;
+pub mod xing;
+pub use probe::*;
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/muxer.rs rmp/src/container/mp3/muxer.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/muxer.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp3/muxer.rs	2026-11-02 17:39:08.768119364 -0700
@@ -0,0 +1,159 @@
+//! MP3 muxer: `[ID3v2.4 tag] [Xing/Info frame] frames...`
+//!
+//! Packets must already contain MPEG audio frames (RMP has no MP3 encoder).
+//! As in FFmpeg's `mp3enc.c`, a placeholder info frame is written up front
+//! and filled in by [`Muxer::finish`] with the frame count, byte count and a
+//! seek table, which gives other players exact duration and VBR seeking.
+
+use super::demuxer::LAME_TAG_KEY;
+use super::id3;
+use super::xing::{self, InfoKind, LAME_TAG_SIZE, TOC_SIZE};
+use crate::codecs::mp3::FrameHeader;
+use crate::codecs::mp3::header::HEADER_SIZE;
+use crate::core::{Metadata, Muxer, Packet, RawValue, Stream, StreamKind};
+use crate::io::Io;
+use crate::message::{Message, Result};
+
+pub struct Mp3Muxer {
+	io: Box<dyn Io>,
+	metadata: Metadata,
+	stream_added: bool,
+	started: bool,
+	/// Header of the first frame: later frames must be compatible.
+	first: Option<FrameHeader>,
+	/// Info frame placeholder: (file position, header).
+	info: Option<(u64, FrameHeader)>,
+	/// Byte offset of every frame, relative to the first audio frame.
+	frame_offsets: Vec<u64>,
+	audio_bytes: u64,
+	constant_bitrate: bool,
+	/// LAME extension from the source stream (gapless info), if any.
+	lame_tag: Option<[u8; LAME_TAG_SIZE]>,
+}
+
+impl Mp3Muxer {
+	pub fn new(io: Box<dyn Io>) -> Self {
+		Self {
+			io,
+			metadata: Metadata::default(),
+			stream_added: false,
+			started: false,
+			first: None,
+			info: None,
+			frame_offsets: Vec::new(),
+			audio_bytes: 0,
+			constant_bitrate: true,
+			lame_tag: None,
+		}
+	}
+
+	fn start(&mut self, first: &FrameHeader) -> Result<()> {
+		let mut position = 0u64;
+		if let Some(tag) = id3::build_v2(&self.metadata)? {
+			self.io.write_all(&tag)?;
+			position += tag.len() as u64;
+		}
+		if let Some(header) = xing::info_frame_header(first, self.lame_tag.is_some()) {
+			// Written for real in `finish`; zeros decode as silence.
+			self.io.write_all(&vec![0u8; header.frame_size])?;
+			self.info = Some((position, header));
+		}
+		self.first = Some(*first);
+		self.started = true;
+		Ok(())
+	}
+
+	fn build_toc(&self, info_size: u64) -> [u8; TOC_SIZE] {
+		let mut toc = [0u8; TOC_SIZE];
+		let frames = self.frame_offsets.len();
+		let total = (info_size + self.audio_bytes).max(1);
+		if frames == 0 {
+			return toc;
+		}
+		for (i, slot) in toc.iter_mut().enumerate() {
+			let frame = (i * frames / TOC_SIZE).min(frames - 1);
+			let offset = info_size + self.frame_offsets[frame];
+			*slot = (u128::from(offset) * 256 / u128::from(total)).min(255) as u8;
+		}
+		toc
+	}
+}
+
+impl Muxer for Mp3Muxer {
+	fn set_metadata(&mut self, metadata: Metadata) -> Result<()> {
+		if self.started {
+			return Err(Message::Container("mp3 metadata must be set before writing"));
+		}
+		self.metadata = metadata;
+		Ok(())
+	}
+
+	fn metadata(&self) -> &Metadata {
+		&self.metadata
+	}
+
+	fn add(&mut self, stream: &Stream) -> Result<usize> {
+		if self.stream_added {
+			return Err(Message::Container("mp3 supports only one stream"));
+		}
+		if stream.kind != StreamKind::Audio
+			|| !matches!(stream.parameters.codec.id.as_str(), "mp3" | "mp2" | "mp1")
+		{
+			return Err(Message::Container("mp3 muxer only accepts mpeg audio streams"));
+		}
+		if let Some(RawValue::Bytes(tag)) = stream.metadata.raw.get(LAME_TAG_KEY) {
+			self.lame_tag = <[u8; LAME_TAG_SIZE]>::try_from(tag.as_slice()).ok();
+		}
+		self.stream_added = true;
+		Ok(0)
+	}
+
+	fn write(&mut self, packet: Packet) -> Result<()> {
+		// Validate every frame in the packet before writing anything.
+		let mut at = 0usize;
+		let mut headers = Vec::new();
+		while at < packet.data.len() {
+			let header = FrameHeader::parse(&packet.data[at..])
+				.filter(|h| at + h.frame_size <= packet.data.len())
+				.ok_or(Message::Container("mp3 muxer: packet is not a sequence of mpeg audio frames"))?;
+			if let Some(first) = self.first.as_ref().or(headers.first()) {
+				if !first.is_compatible(&header) {
+					return Err(Message::Container("mp3 muxer: incompatible frame in stream"));
+				}
+			}
+			headers.push(header);
+			at += header.frame_size;
+		}
+		let Some(&first_in_packet) = headers.first() else { return Ok(()) };
+
+		if !self.started {
+			self.start(&first_in_packet)?;
+		}
+		let reference_bitrate = self.first.map(|f| f.bitrate_kbps);
+		let mut offset = self.audio_bytes;
+		for header in &headers {
+			self.frame_offsets.push(offset);
+			offset += header.frame_size as u64;
+			if Some(header.bitrate_kbps) != reference_bitrate {
+				self.constant_bitrate = false;
+			}
+		}
+		self.io.write_all(&packet.data)?;
+		self.audio_bytes = offset;
+		Ok(())
+	}
+
+	fn finish(&mut self) -> Result<()> {
+		let Some((position, header)) = self.info else { return Ok(()) };
+		let info_size = header.frame_size as u64;
+		let frames = u32::try_from(self.frame_offsets.len()).unwrap_or(u32::MAX);
+		let bytes = u32::try_from(info_size + self.audio_bytes).unwrap_or(u32::MAX);
+		let kind = if self.constant_bitrate { InfoKind::Info } else { InfoKind::Xing };
+		let toc = self.build_toc(info_size);
+		let frame = xing::build_info_frame(&header, kind, frames, bytes, &toc, self.lame_tag.as_ref());
+		debug_assert!(frame.len() >= HEADER_SIZE);
+		self.io.seek(position)?;
+		self.io.write_all(&frame)?;
+		Ok(())
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/probe.rs rmp/src/container/mp3/probe.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/probe.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp3/probe.rs	2026-11-02 17:20:41.962173239 -0700
@@ -0,0 +1,77 @@
+use super::id3;
+use crate::codecs::mp3::FrameHeader;
+use crate::codecs::mp3::header::HEADER_SIZE;
+use crate::core::{Demuxer, Hint, Muxer, Probe};
+use crate::io::Io;
+use crate::message::Result;
+
+/// Consecutive matching frames required to claim a stream without ID3 tag.
+const REQUIRED_FRAMES: usize = 3;
+
+pub struct Mp3Probe;
+
+/// Length of the chain of compatible frames starting at `start`, and whether
+/// the chain ran off the end of `data` (i.e. it might continue).
+fn frame_chain(data: &[u8], start: usize) -> (usize, bool) {
+	let Some(first) = FrameHeader::parse(&data[start..]) else { return (0, false) };
+	let mut count = 0;
+	let mut at = start;
+	loop {
+		match data.get(at..).and_then(FrameHeader::parse) {
+			Some(h) if h.is_compatible(&first) => {
+				count += 1;
+				at += h.frame_size;
+			}
+			_ => return (count, at + HEADER_SIZE > data.len()),
+		}
+	}
+}
+
+impl Probe for Mp3Probe {
+	/// Like FFmpeg's `mp3_read_probe`: skip ID3v2, then require a run of
+	/// consistent frame headers. Since MPEG audio has only an 11-bit sync
+	/// word, this is checked after the formats with real magic numbers.
+	fn demuxer_matches(data: &[u8]) -> bool {
+		let mut start = 0;
+		while let Some(size) = data.get(start..).and_then(id3::v2_tag_size) {
+			start += size;
+			if start >= data.len() {
+				// Tag extends past the probe window; ID3v2 is an MP3 tag format.
+				return true;
+			}
+		}
+		let tagged = start > 0;
+		let end = data.len().saturating_sub(HEADER_SIZE - 1);
+		for i in start..end {
+			if data[i] != 0xFF {
+				continue;
+			}
+			let (count, open_ended) = frame_chain(data, i);
+			if count >= REQUIRED_FRAMES || (count >= 1 && open_ended && (tagged || count >= 2)) {
+				return true;
+			}
+			// Without a tag, the sync must be near the start of the data.
+			if !tagged && i > 2048 {
+				return false;
+			}
+		}
+		false
+	}
+
+	fn muxer_matches(hint: &Hint) -> bool {
+		if let Some(mime) = hint.mime_type.as_deref().map(str::trim) {
+			if mime == "audio/mpeg" || mime == "audio/mp3" {
+				return true;
+			}
+		}
+		hint.extension.as_deref().is_some_and(|e| e.eq_ignore_ascii_case("mp3"))
+	}
+
+	fn create_demuxer(io: Box<dyn Io>) -> Result<Box<dyn Demuxer>> {
+		Ok(Box::new(super::demuxer::Mp3Demuxer::new(io)?))
+	}
+
+	fn create_muxer(io: Box<dyn Io>) -> Result<Box<dyn Muxer>> {
+		Ok(Box::new(super::muxer::Mp3Muxer::new(io)))
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/xing.rs rmp/src/container/mp3/xing.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp3/xing.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp3/xing.rs	2026-11-02 17:22:52.669396153 -0700
@@ -0,0 +1,187 @@
+//! Xing / Info / VBRI header frames.
+//!
+//! Encoders store stream-level info in the first MPEG frame (whose audio is
+//! silent): total frame and byte counts (for exact duration), a 100-entry
+//! seek table (TOC) and, in the LAME extension, encoder delay/padding for
+//! gapless playback. Mirrors FFmpeg's `mp3_parse_info_tag` /
+//! `mp3_parse_vbri_tag`, and `mp3enc.c` for writing.
+
+use crate::codecs::mp3::{FrameHeader, header::HEADER_SIZE};
+use crate::io::ByteCursor;
+
+pub const TOC_SIZE: usize = 100;
+const XING_FLAG_FRAMES: u32 = 0x1;
+const XING_FLAG_BYTES: u32 = 0x2;
+const XING_FLAG_TOC: u32 = 0x4;
+const XING_FLAG_QUALITY: u32 = 0x8;
+/// VBRI always sits 32 bytes after the frame header.
+const VBRI_OFFSET: usize = HEADER_SIZE + 32;
+/// Size of the LAME extension that may follow the Xing fields.
+pub const LAME_TAG_SIZE: usize = 36;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum InfoKind {
+	/// "Xing": variable bitrate.
+	Xing,
+	/// "Info": constant bitrate (same layout as Xing).
+	Info,
+	/// Fraunhofer "VBRI".
+	Vbri,
+}
+
+#[derive(Debug, Clone)]
+pub struct InfoTag {
+	pub kind: InfoKind,
+	/// Audio frames in the stream, excluding this info frame.
+	pub frames: Option<u32>,
+	/// Stream size in bytes (Xing: including the info frame).
+	pub bytes: Option<u32>,
+	/// Seek table: `toc[i]` = byte position of `i`% of the duration, in 1/256
+	/// units of `bytes`.
+	pub toc: Option<[u8; TOC_SIZE]>,
+	/// LAME gapless info, in samples.
+	pub encoder_delay: Option<u32>,
+	pub encoder_padding: Option<u32>,
+	/// The raw 36-byte LAME extension, kept so a remux can reproduce it.
+	pub lame_tag: Option<[u8; LAME_TAG_SIZE]>,
+}
+
+/// Looks for an info tag inside `frame` (a complete first frame).
+pub fn parse(frame: &[u8], header: &FrameHeader) -> Option<InfoTag> {
+	parse_xing(frame, header).or_else(|| parse_vbri(frame))
+}
+
+fn parse_xing(frame: &[u8], header: &FrameHeader) -> Option<InfoTag> {
+	let offset = HEADER_SIZE + header.side_info_size();
+	let mut c = ByteCursor::new(frame.get(offset..)?);
+	let kind = match &c.read_fourcc().ok()? {
+		b"Xing" => InfoKind::Xing,
+		b"Info" => InfoKind::Info,
+		_ => return None,
+	};
+	let flags = c.read_u32().ok()?;
+	let frames = if flags & XING_FLAG_FRAMES != 0 { Some(c.read_u32().ok()?) } else { None };
+	let bytes = if flags & XING_FLAG_BYTES != 0 { Some(c.read_u32().ok()?) } else { None };
+	let toc = if flags & XING_FLAG_TOC != 0 { Some(c.read_array::<TOC_SIZE>().ok()?) } else { None };
+	if flags & XING_FLAG_QUALITY != 0 {
+		c.skip(4).ok()?;
+	}
+
+	// Optional LAME extension: 9-byte encoder string, then fixed fields; the
+	// 24-bit delay/padding pair sits 21 bytes into the extension.
+	let (mut encoder_delay, mut encoder_padding, mut lame_tag) = (None, None, None);
+	let lame = c.rest();
+	if lame.len() >= LAME_TAG_SIZE && [&b"LAME"[..], b"Lavf", b"Lavc"].contains(&&lame[..4]) {
+		let d = &lame[21..24];
+		encoder_delay = Some((u32::from(d[0]) << 4) | (u32::from(d[1]) >> 4));
+		encoder_padding = Some((u32::from(d[1] & 0x0F) << 8) | u32::from(d[2]));
+		let mut tag = [0u8; LAME_TAG_SIZE];
+		tag.copy_from_slice(&lame[..LAME_TAG_SIZE]);
+		lame_tag = Some(tag);
+	}
+
+	Some(InfoTag {
+		kind,
+		frames: frames.filter(|&f| f > 0),
+		bytes: bytes.filter(|&b| b > 0),
+		toc,
+		encoder_delay,
+		encoder_padding,
+		lame_tag,
+	})
+}
+
+fn parse_vbri(frame: &[u8]) -> Option<InfoTag> {
+	let mut c = ByteCursor::new(frame.get(VBRI_OFFSET..)?);
+	if &c.read_fourcc().ok()? != b"VBRI" {
+		return None;
+	}
+	let _version = c.read_u16().ok()?;
+	let delay = c.read_u16().ok()?;
+	let _quality = c.read_u16().ok()?;
+	let bytes = c.read_u32().ok()?;
+	let frames = c.read_u32().ok()?;
+	Some(InfoTag {
+		kind: InfoKind::Vbri,
+		frames: Some(frames).filter(|&f| f > 0),
+		bytes: Some(bytes).filter(|&b| b > 0),
+		toc: None,
+		encoder_delay: Some(u32::from(delay)),
+		encoder_padding: None,
+		lame_tag: None,
+	})
+}
+
+/// Builds the header of an info frame compatible with `first` (same version,
+/// sample rate and channel mode), using the smallest bitrate whose frame can
+/// hold a Xing tag with TOC (plus a LAME extension when `with_lame`).
+/// Returns `None` for non-Layer III streams.
+pub fn info_frame_header(first: &FrameHeader, with_lame: bool) -> Option<FrameHeader> {
+	if first.layer != 3 {
+		return None;
+	}
+	let lame = if with_lame { LAME_TAG_SIZE } else { 0 };
+	let needed = HEADER_SIZE + first.side_info_size() + 4 + 4 + 4 + 4 + TOC_SIZE + lame;
+	let mut raw = first.raw;
+	raw[1] |= 0x01; // no CRC
+	raw[3] &= 0xC0; // keep channel mode, clear extension/copyright/emphasis
+	(1u8..=14).find_map(|bitrate_index| {
+		raw[2] = (bitrate_index << 4) | (first.raw[2] & 0x0C); // keep rate, no padding
+		FrameHeader::parse(&raw).filter(|h| h.frame_size >= needed)
+	})
+}
+
+/// CRC-16/ARC (poly 0x8005 reflected, init 0), as used by the LAME tag.
+fn crc16(data: &[u8]) -> u16 {
+	let mut crc = 0u16;
+	for &byte in data {
+		crc ^= u16::from(byte);
+		for _ in 0..8 {
+			crc = if crc & 1 != 0 { (crc >> 1) ^ 0xA001 } else { crc >> 1 };
+		}
+	}
+	crc
+}
+
+/// Serialises a complete Xing/Info frame, optionally followed by a LAME
+/// extension (whose trailing tag CRC is recomputed for the new frame).
+pub fn build_info_frame(
+	header: &FrameHeader,
+	kind: InfoKind,
+	frames: u32,
+	bytes: u32,
+	toc: &[u8; TOC_SIZE],
+	lame_tag: Option<&[u8; LAME_TAG_SIZE]>,
+) -> Vec<u8> {
+	let mut frame = vec![0u8; header.frame_size];
+	frame[..HEADER_SIZE].copy_from_slice(&header.raw);
+	let mut tag = Vec::with_capacity(16 + TOC_SIZE);
+	tag.extend_from_slice(if kind == InfoKind::Info { b"Info" } else { b"Xing" });
+	tag.extend_from_slice(&(XING_FLAG_FRAMES | XING_FLAG_BYTES | XING_FLAG_TOC).to_be_bytes());
+	tag.extend_from_slice(&frames.to_be_bytes());
+	tag.extend_from_slice(&bytes.to_be_bytes());
+	tag.extend_from_slice(toc);
+	if let Some(lame) = lame_tag {
+		tag.extend_from_slice(lame);
+	}
+	let offset = HEADER_SIZE + header.side_info_size();
+	let end = (offset + tag.len()).min(frame.len());
+	frame[offset..end].copy_from_slice(&tag[..end - offset]);
+	if lame_tag.is_some() && end == offset + tag.len() {
+		// The tag CRC covers every byte of the frame before it.
+		let crc = crc16(&frame[..end - 2]);
+		frame[end - 2..end].copy_from_slice(&crc.to_be_bytes());
+	}
+	frame
+}
+
+/// Byte offset for `percent` (0.0..=100.0) using a Xing TOC, with linear
+/// interpolation between entries (FFmpeg's `mp3_seek` behaviour).
+pub fn toc_offset(toc: &[u8; TOC_SIZE], bytes: u64, percent: f64) -> u64 {
+	let p = percent.clamp(0.0, 99.999);
+	let index = p as usize;
+	let fa = f64::from(toc[index]);
+	let fb = if index + 1 < TOC_SIZE { f64::from(toc[index + 1]) } else { 256.0 };
+	let fx = fa + (fb - fa) * (p - index as f64);
+	(fx / 256.0 * bytes as f64) as u64
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/boxes.rs rmp/src/container/mp4/boxes.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/boxes.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/boxes.rs	2026-11-02 17:24:30.519441541 -0700
@@ -0,0 +1,195 @@
+//! ISO Base Media File Format (ISO/IEC 14496-12) box primitives.
+//!
+//! Reading works on in-memory slices (the `moov` box is loaded whole, like
+//! FFmpeg's `mov_read_header` walk), so every access is a bounds-checked
+//! slice operation. Writing appends to a `Vec<u8>` and back-patches sizes.
+
+use crate::io::ByteCursor;
+use crate::message::{Message, Result};
+
+pub type FourCC = [u8; 4];
+
+/// Iterates over the boxes contained in a byte slice.
+///
+/// A truncated final box is clamped to the available bytes (FFmpeg also
+/// tolerates this, which keeps partially-downloaded files playable); a box
+/// whose size is smaller than its own header is an error.
+pub struct BoxIter<'a> {
+	cursor: ByteCursor<'a>,
+	failed: bool,
+}
+
+impl<'a> BoxIter<'a> {
+	pub fn new(data: &'a [u8]) -> Self {
+		Self { cursor: ByteCursor::new(data), failed: false }
+	}
+}
+
+impl<'a> Iterator for BoxIter<'a> {
+	type Item = Result<(FourCC, &'a [u8])>;
+
+	fn next(&mut self) -> Option<Self::Item> {
+		if self.failed || self.cursor.remaining() < 8 {
+			return None;
+		}
+		let result = (|| {
+			let size = u64::from(self.cursor.read_u32()?);
+			let kind = self.cursor.read_fourcc()?;
+			let (size, header) = match size {
+				0 => (8 + self.cursor.remaining() as u64, 8),
+				1 => (self.cursor.read_u64()?, 16),
+				_ => (size, 8),
+			};
+			if size < header {
+				return Err(Message::Container("invalid mp4 box size"));
+			}
+			let body_len = usize::try_from(size - header).unwrap_or(usize::MAX);
+			let body = self.cursor.read_bytes(body_len.min(self.cursor.remaining()))?;
+			Ok((kind, body))
+		})();
+		if result.is_err() {
+			self.failed = true;
+		}
+		Some(result)
+	}
+}
+
+/// First direct child of `kind`, ignoring malformed trailing data.
+pub fn find<'a>(data: &'a [u8], kind: &FourCC) -> Option<&'a [u8]> {
+	BoxIter::new(data).map_while(|r| r.ok()).find(|(k, _)| k == kind).map(|(_, body)| body)
+}
+
+/// Follows a path of nested boxes, e.g. `[b"mdia", b"minf", b"stbl"]`.
+pub fn find_path<'a>(data: &'a [u8], path: &[&FourCC]) -> Option<&'a [u8]> {
+	path.iter().try_fold(data, |current, kind| find(current, kind))
+}
+
+/// Splits a "full box" body into (version, flags, payload).
+pub fn full_box(body: &[u8]) -> Result<(u8, u32, &[u8])> {
+	let header = body.get(..4).ok_or(Message::Container("truncated mp4 full box"))?;
+	let flags = u32::from_be_bytes([0, header[1], header[2], header[3]]);
+	Ok((header[0], flags, &body[4..]))
+}
+
+/// Human-readable four-character code (0xA9 → '©', as in iTunes tags).
+pub fn fourcc_string(kind: &FourCC) -> String {
+	kind.iter().map(|&b| char::from(b)).collect::<String>().trim_end().to_string()
+}
+
+/// Big-endian append helpers for building boxes.
+pub trait Put {
+	fn put_u8(&mut self, v: u8);
+	fn put_u16(&mut self, v: u16);
+	fn put_u24(&mut self, v: u32);
+	fn put_u32(&mut self, v: u32);
+	fn put_i32(&mut self, v: i32);
+	fn put_u64(&mut self, v: u64);
+	fn put(&mut self, bytes: &[u8]);
+	fn put_zeros(&mut self, n: usize);
+}
+
+impl Put for Vec<u8> {
+	fn put_u8(&mut self, v: u8) {
+		self.push(v);
+	}
+	fn put_u16(&mut self, v: u16) {
+		self.extend_from_slice(&v.to_be_bytes());
+	}
+	fn put_u24(&mut self, v: u32) {
+		self.extend_from_slice(&v.to_be_bytes()[1..]);
+	}
+	fn put_u32(&mut self, v: u32) {
+		self.extend_from_slice(&v.to_be_bytes());
+	}
+	fn put_i32(&mut self, v: i32) {
+		self.extend_from_slice(&v.to_be_bytes());
+	}
+	fn put_u64(&mut self, v: u64) {
+		self.extend_from_slice(&v.to_be_bytes());
+	}
+	fn put(&mut self, bytes: &[u8]) {
+		self.extend_from_slice(bytes);
+	}
+	fn put_zeros(&mut self, n: usize) {
+		self.resize(self.len() + n, 0);
+	}
+}
+
+/// Starts a box; returns the offset to pass to [`end_box`].
+pub fn begin_box(out: &mut Vec<u8>, kind: &FourCC) -> usize {
+	let at = out.len();
+	out.put_u32(0);
+	out.put(kind);
+	at
+}
+
+/// Starts a full box (version + flags).
+pub fn begin_full_box(out: &mut Vec<u8>, kind: &FourCC, version: u8, flags: u32) -> usize {
+	let at = begin_box(out, kind);
+	out.put_u8(version);
+	out.put_u24(flags);
+	at
+}
+
+/// Back-patches the size of the box started at `at`.
+pub fn end_box(out: &mut [u8], at: usize) -> Result<()> {
+	let size = u32::try_from(out.len() - at).map_err(|_| Message::Container("mp4 box too large"))?;
+	out[at..at + 4].copy_from_slice(&size.to_be_bytes());
+	Ok(())
+}
+
+/// Writes a complete box whose body is produced by `body`.
+pub fn write_box(
+	out: &mut Vec<u8>,
+	kind: &FourCC,
+	body: impl FnOnce(&mut Vec<u8>) -> Result<()>,
+) -> Result<()> {
+	let at = begin_box(out, kind);
+	body(out)?;
+	end_box(out, at)
+}
+
+/// Writes a complete full box whose body is produced by `body`.
+pub fn write_full_box(
+	out: &mut Vec<u8>,
+	kind: &FourCC,
+	version: u8,
+	flags: u32,
+	body: impl FnOnce(&mut Vec<u8>) -> Result<()>,
+) -> Result<()> {
+	let at = begin_full_box(out, kind, version, flags);
+	body(out)?;
+	end_box(out, at)
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn iterates_and_round_trips() {
+		let mut out = Vec::new();
+		write_box(&mut out, b"moov", |o| {
+			write_full_box(o, b"mvhd", 0, 0, |o| {
+				o.put_u32(7);
+				Ok(())
+			})?;
+			write_box(o, b"trak", |_| Ok(()))
+		})
+		.unwrap();
+		let moov = find(&out, b"moov").unwrap();
+		let kinds: Vec<_> = BoxIter::new(moov).map(|r| r.unwrap().0).collect();
+		assert_eq!(kinds, vec![*b"mvhd", *b"trak"]);
+		let (version, _, payload) = full_box(find(moov, b"mvhd").unwrap()).unwrap();
+		assert_eq!((version, payload), (0, &[0, 0, 0, 7][..]));
+	}
+
+	#[test]
+	fn rejects_undersized_box_and_clamps_truncated_box() {
+		let bad = [0, 0, 0, 4, b'f', b'r', b'e', b'e'];
+		assert!(BoxIter::new(&bad).next().unwrap().is_err());
+		let truncated = [0, 0, 0, 100, b'm', b'd', b'a', b't', 1, 2];
+		let (kind, body) = BoxIter::new(&truncated).next().unwrap().unwrap();
+		assert_eq!((&kind, body), (b"mdat", &[1, 2][..]));
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/codec.rs rmp/src/container/mp4/codec.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/codec.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/codec.rs	2026-11-02 17:40:32.796482219 -0700
@@ -0,0 +1,489 @@
+//! Sample descriptions (`stsd` entries): mapping between MP4 sample entries
+//! and RMP codec ids + parameters, in both directions.
+//!
+//! Codec ids follow FFmpeg's names (`h264`, `hevc`, `aac`, `mp3`, …) and the
+//! codec configuration record (`avcC`, `hvcC`, the AAC AudioSpecificConfig in
+//! `esds`, …) is carried as [`Parameters::extradata`], exactly like
+//! `AVCodecParameters.extradata`.
+
+use super::boxes::{BoxIter, FourCC, Put, find, full_box, write_box, write_full_box};
+use crate::core::StreamKind;
+use crate::io::ByteCursor;
+use crate::message::{Message, Result};
+
+/// Decoded sample description of a track.
+#[derive(Debug, Clone, Default)]
+pub struct CodecInfo {
+	pub codec: String,
+	pub width: Option<u32>,
+	pub height: Option<u32>,
+	pub sample_rate: Option<u32>,
+	pub channels: Option<u8>,
+	pub extradata: Vec<u8>,
+	pub bitrate: Option<u32>,
+}
+
+/// MPEG-4 Systems object type indications (ISO/IEC 14496-1, Table 5).
+mod oti {
+	pub const MPEG4_VISUAL: u8 = 0x20;
+	pub const AAC: u8 = 0x40;
+	pub const MPEG2_AAC_MAIN: u8 = 0x66;
+	pub const MPEG2_AAC_LC: u8 = 0x67;
+	pub const MPEG2_AAC_SSR: u8 = 0x68;
+	pub const MPEG2_AUDIO: u8 = 0x69;
+	pub const MPEG1_AUDIO: u8 = 0x6B;
+}
+
+/// Bytes of fixed fields in a VisualSampleEntry after the box header.
+const VISUAL_ENTRY_FIELDS: usize = 78;
+/// Bytes of fixed fields in a (version 0) AudioSampleEntry.
+const AUDIO_ENTRY_FIELDS: usize = 28;
+
+/// Parses the first entry of an `stsd` box.
+pub fn parse_stsd(stsd: &[u8], kind: StreamKind) -> Result<CodecInfo> {
+	let (_, _, payload) = full_box(stsd)?;
+	let mut c = ByteCursor::new(payload);
+	let count = c.read_u32()?;
+	if count == 0 {
+		return Err(Message::Container("mp4 stsd has no sample entry"));
+	}
+	let (format, entry) =
+		BoxIter::new(c.rest()).next().ok_or(Message::Container("mp4 stsd has no sample entry"))??;
+
+	match kind {
+		StreamKind::Video => parse_visual_entry(&format, entry),
+		StreamKind::Audio => parse_audio_entry(&format, entry),
+		_ => Ok(CodecInfo { codec: codec_from_fourcc(&format), ..Default::default() }),
+	}
+}
+
+fn parse_visual_entry(format: &FourCC, entry: &[u8]) -> Result<CodecInfo> {
+	let mut c = ByteCursor::new(entry);
+	c.skip(8 + 16)?; // reserved, data_reference_index, pre_defined/reserved
+	let width = u32::from(c.read_u16()?);
+	let height = u32::from(c.read_u16()?);
+	let children = entry.get(VISUAL_ENTRY_FIELDS..).unwrap_or(&[]);
+
+	let mut info = CodecInfo {
+		codec: codec_from_fourcc(format),
+		width: Some(width),
+		height: Some(height),
+		..Default::default()
+	};
+	let config: Option<&FourCC> = match format {
+		b"avc1" | b"avc3" => Some(b"avcC"),
+		b"hvc1" | b"hev1" => Some(b"hvcC"),
+		b"av01" => Some(b"av1C"),
+		b"vp09" => Some(b"vpcC"),
+		_ => None,
+	};
+	if let Some(config) = config {
+		info.extradata = find(children, config).unwrap_or(&[]).to_vec();
+	}
+	if let Some(esds) = find(children, b"esds") {
+		if let Some(es) = parse_esds(esds) {
+			info.codec = codec_from_oti(es.object_type, StreamKind::Video).to_string();
+			info.extradata = es.decoder_specific_info;
+			info.bitrate = Some(es.avg_bitrate).filter(|&b| b > 0);
+		}
+	}
+	if let Some(btrt) = find(children, b"btrt") {
+		info.bitrate = info.bitrate.or(parse_btrt(btrt));
+	}
+	Ok(info)
+}
+
+fn parse_audio_entry(format: &FourCC, entry: &[u8]) -> Result<CodecInfo> {
+	let mut c = ByteCursor::new(entry);
+	c.skip(8)?; // reserved, data_reference_index
+	let version = c.read_u16()?; // QuickTime sound description version
+	c.skip(2 + 4)?; // revision, vendor
+	let mut channels = u32::from(c.read_u16()?);
+	let sample_size = c.read_u16()?;
+	c.skip(4)?; // compression id, packet size
+	let mut sample_rate = c.read_u32()? >> 16;
+	let children_at = match version {
+		1 => AUDIO_ENTRY_FIELDS + 16,
+		2 => {
+			c.skip(4)?; // sizeOfStructOnly
+			let rate = f64::from_bits(c.read_u64()?);
+			if rate.is_finite() && rate > 0.0 && rate < f64::from(u32::MAX) {
+				sample_rate = rate as u32;
+			}
+			channels = c.read_u32()?;
+			AUDIO_ENTRY_FIELDS + 36
+		}
+		_ => AUDIO_ENTRY_FIELDS,
+	};
+	let mut children = entry.get(children_at..).unwrap_or(&[]);
+	// QuickTime wraps codec boxes in a `wave` box.
+	if let Some(wave) = find(children, b"wave") {
+		children = wave;
+	}
+
+	let mut info = CodecInfo {
+		codec: codec_from_fourcc(format),
+		sample_rate: Some(sample_rate).filter(|&r| r > 0),
+		channels: u8::try_from(channels).ok().filter(|&c| c > 0),
+		..Default::default()
+	};
+	if (format == b"twos" || format == b"sowt") && sample_size == 8 {
+		info.codec = "pcm_s8".into();
+	}
+
+	if let Some(es) = find(children, b"esds").and_then(parse_esds) {
+		info.codec = codec_from_oti(es.object_type, StreamKind::Audio).to_string();
+		info.bitrate = Some(es.avg_bitrate).filter(|&b| b > 0);
+		if info.codec == "aac" {
+			if let Some((rate, ch)) = parse_audio_specific_config(&es.decoder_specific_info) {
+				info.sample_rate = Some(rate);
+				if ch > 0 {
+					info.channels = Some(ch);
+				}
+			}
+		}
+		info.extradata = es.decoder_specific_info;
+	} else {
+		let config: Option<&FourCC> = match format {
+			b"Opus" => Some(b"dOps"),
+			b"fLaC" => Some(b"dfLa"),
+			b"alac" => Some(b"alac"),
+			_ => None,
+		};
+		if let Some(config) = config {
+			info.extradata = find(children, config).unwrap_or(&[]).to_vec();
+		}
+	}
+	if let Some(btrt) = find(children, b"btrt") {
+		info.bitrate = info.bitrate.or(parse_btrt(btrt));
+	}
+	Ok(info)
+}
+
+fn parse_btrt(body: &[u8]) -> Option<u32> {
+	let mut c = ByteCursor::new(body);
+	c.skip(8).ok()?; // bufferSizeDB, maxBitrate
+	c.read_u32().ok().filter(|&b| b > 0)
+}
+
+fn codec_from_fourcc(format: &FourCC) -> String {
+	let name = match format {
+		b"avc1" | b"avc3" => "h264",
+		b"hvc1" | b"hev1" => "hevc",
+		b"av01" => "av1",
+		b"vp09" => "vp9",
+		b"mp4v" => "mpeg4",
+		b"jpeg" | b"mjpa" => "mjpeg",
+		b"mp4a" => "aac",
+		b".mp3" | b"ms\0U" => "mp3",
+		b"Opus" => "opus",
+		b"fLaC" => "flac",
+		b"alac" => "alac",
+		b"ac-3" => "ac3",
+		b"ec-3" => "eac3",
+		b"sowt" => "pcm_s16le",
+		b"twos" => "pcm_s16be",
+		b"tx3g" => "mov_text",
+		b"wvtt" => "webvtt",
+		_ => return super::boxes::fourcc_string(format).to_lowercase(),
+	};
+	name.to_string()
+}
+
+fn codec_from_oti(object_type: u8, kind: StreamKind) -> &'static str {
+	match object_type {
+		oti::MPEG4_VISUAL => "mpeg4",
+		0x60..=0x65 => "mpeg2video",
+		0x6A => "mpeg1video",
+		0x6C => "mjpeg",
+		oti::AAC | oti::MPEG2_AAC_MAIN | oti::MPEG2_AAC_LC | oti::MPEG2_AAC_SSR => "aac",
+		oti::MPEG2_AUDIO | oti::MPEG1_AUDIO => "mp3",
+		0xA5 => "ac3",
+		0xA6 => "eac3",
+		0xA9..=0xAC => "dts",
+		0xAD => "opus",
+		_ if kind == StreamKind::Video => "mpeg4",
+		_ => "aac",
+	}
+}
+
+/// Fields of an `esds` ES_Descriptor that matter for decoding.
+#[derive(Debug, Clone, Default)]
+pub struct EsDescriptor {
+	pub object_type: u8,
+	pub avg_bitrate: u32,
+	pub decoder_specific_info: Vec<u8>,
+}
+
+/// Reads an MPEG-4 descriptor header: tag and "expandable" length.
+fn read_descriptor(c: &mut ByteCursor) -> Option<(u8, usize)> {
+	let tag = c.read_u8().ok()?;
+	let mut len = 0usize;
+	for _ in 0..4 {
+		let b = c.read_u8().ok()?;
+		len = (len << 7) | usize::from(b & 0x7F);
+		if b & 0x80 == 0 {
+			break;
+		}
+	}
+	Some((tag, len))
+}
+
+/// Parses an `esds` box body (ISO/IEC 14496-1 §7.2.6.5).
+pub fn parse_esds(body: &[u8]) -> Option<EsDescriptor> {
+	let (_, _, payload) = full_box(body).ok()?;
+	let mut c = ByteCursor::new(payload);
+	let (tag, _) = read_descriptor(&mut c)?;
+	if tag != 0x03 {
+		return None;
+	}
+	c.skip(2).ok()?; // ES_ID
+	let flags = c.read_u8().ok()?;
+	if flags & 0x80 != 0 {
+		c.skip(2).ok()?; // dependsOn_ES_ID
+	}
+	if flags & 0x40 != 0 {
+		let url_len = usize::from(c.read_u8().ok()?);
+		c.skip(url_len).ok()?;
+	}
+	if flags & 0x20 != 0 {
+		c.skip(2).ok()?; // OCR_ES_Id
+	}
+
+	let (tag, _) = read_descriptor(&mut c)?;
+	if tag != 0x04 {
+		return None;
+	}
+	let mut es = EsDescriptor { object_type: c.read_u8().ok()?, ..Default::default() };
+	c.skip(1 + 3 + 4).ok()?; // stream type, buffer size, max bitrate
+	es.avg_bitrate = c.read_u32().ok()?;
+	if let Some((0x05, len)) = read_descriptor(&mut c) {
+		es.decoder_specific_info = c.read_bytes(len.min(c.remaining())).ok()?.to_vec();
+	}
+	Some(es)
+}
+
+const AAC_SAMPLE_RATES: [u32; 13] =
+	[96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350];
+
+/// Extracts (sample rate, channel configuration) from an AAC
+/// AudioSpecificConfig (ISO/IEC 14496-3 §1.6.2.1).
+pub fn parse_audio_specific_config(asc: &[u8]) -> Option<(u32, u8)> {
+	let mut bits = 0u64;
+	for (i, &b) in asc.iter().take(8).enumerate() {
+		bits |= u64::from(b) << (56 - 8 * i);
+	}
+	let available = asc.len().min(8) * 8;
+	let mut pos = 0usize;
+	let mut take = |n: usize| -> Option<u32> {
+		if pos + n > available {
+			return None;
+		}
+		let v = ((bits << pos) >> (64 - n)) as u32;
+		pos += n;
+		Some(v)
+	};
+	let mut object_type = take(5)?;
+	if object_type == 31 {
+		object_type = 32 + take(6)?;
+	}
+	let _ = object_type;
+	let index = take(4)? as usize;
+	let rate = if index == 15 { take(24)? } else { *AAC_SAMPLE_RATES.get(index)? };
+	let channels = take(4)? as u8;
+	Some((rate, channels))
+}
+
+/// Parameters needed to write a sample entry.
+pub struct EntryParams<'a> {
+	pub codec: &'a str,
+	pub kind: StreamKind,
+	pub width: u32,
+	pub height: u32,
+	pub sample_rate: u32,
+	pub channels: u8,
+	pub extradata: &'a [u8],
+	pub track_id: u32,
+	pub avg_bitrate: u32,
+	pub max_bitrate: u32,
+	pub buffer_size: u32,
+}
+
+/// Codecs the MP4 muxer can describe.
+pub fn muxer_supports(codec: &str) -> bool {
+	matches!(codec, "h264" | "hevc" | "av1" | "mpeg4" | "aac" | "mp3" | "alac" | "opus" | "flac")
+}
+
+/// Writes a complete `stsd` box with one sample entry.
+pub fn write_stsd(out: &mut Vec<u8>, p: &EntryParams) -> Result<()> {
+	write_full_box(out, b"stsd", 0, 0, |out| {
+		out.put_u32(1);
+		match p.kind {
+			StreamKind::Video => write_visual_entry(out, p),
+			StreamKind::Audio => write_audio_entry(out, p),
+			_ => Err(Message::Container("mp4 muxer supports only audio and video streams")),
+		}
+	})
+}
+
+fn require_extradata<'a>(p: &EntryParams<'a>) -> Result<&'a [u8]> {
+	if p.extradata.is_empty() {
+		return Err(Message::Container("mp4 muxer: codec requires extradata (decoder configuration)"));
+	}
+	Ok(p.extradata)
+}
+
+fn write_visual_entry(out: &mut Vec<u8>, p: &EntryParams) -> Result<()> {
+	let (format, config): (&FourCC, Option<&FourCC>) = match p.codec {
+		"h264" => (b"avc1", Some(b"avcC")),
+		"hevc" => (b"hvc1", Some(b"hvcC")),
+		"av1" => (b"av01", Some(b"av1C")),
+		"mpeg4" => (b"mp4v", None),
+		_ => return Err(Message::Container("mp4 muxer: unsupported video codec")),
+	};
+	let width =
+		u16::try_from(p.width).map_err(|_| Message::Container("mp4 video width too large"))?;
+	let height =
+		u16::try_from(p.height).map_err(|_| Message::Container("mp4 video height too large"))?;
+	write_box(out, format, |out| {
+		out.put_zeros(6);
+		out.put_u16(1); // data_reference_index
+		out.put_zeros(16); // pre_defined / reserved
+		out.put_u16(width);
+		out.put_u16(height);
+		out.put_u32(0x0048_0000); // 72 dpi
+		out.put_u32(0x0048_0000);
+		out.put_u32(0);
+		out.put_u16(1); // frame_count
+		out.put_zeros(32); // compressorname
+		out.put_u16(0x0018); // depth
+		out.put_u16(0xFFFF); // pre_defined = -1
+		match config {
+			Some(config) => {
+				let extradata = require_extradata(p)?;
+				write_box(out, config, |out| {
+					out.put(extradata);
+					Ok(())
+				})
+			}
+			None => write_esds(out, p, oti::MPEG4_VISUAL, 0x04),
+		}
+	})
+}
+
+fn write_audio_entry(out: &mut Vec<u8>, p: &EntryParams) -> Result<()> {
+	let format: &FourCC = match p.codec {
+		"aac" | "mp3" => b"mp4a",
+		"alac" => b"alac",
+		"opus" => b"Opus",
+		"flac" => b"fLaC",
+		_ => return Err(Message::Container("mp4 muxer: unsupported audio codec")),
+	};
+	write_box(out, format, |out| {
+		out.put_zeros(6);
+		out.put_u16(1); // data_reference_index
+		out.put_zeros(8); // version 0 sound description
+		out.put_u16(u16::from(p.channels));
+		out.put_u16(16); // sample size
+		out.put_u32(0); // pre_defined, reserved
+		// 16.16 fixed point; rates above 65535 Hz cannot be represented and
+		// are signalled by the codec configuration instead.
+		out.put_u32(if p.sample_rate <= 0xFFFF { p.sample_rate << 16 } else { 0 });
+		match p.codec {
+			"aac" => {
+				require_extradata(p)?;
+				write_esds(out, p, oti::AAC, 0x05)
+			}
+			"mp3" => {
+				let object_type = if p.sample_rate >= 32_000 { oti::MPEG1_AUDIO } else { oti::MPEG2_AUDIO };
+				write_esds(out, p, object_type, 0x05)
+			}
+			"alac" | "opus" | "flac" => {
+				let config: &FourCC = match p.codec {
+					"alac" => b"alac",
+					"opus" => b"dOps",
+					_ => b"dfLa",
+				};
+				let extradata = require_extradata(p)?;
+				write_box(out, config, |out| {
+					out.put(extradata);
+					Ok(())
+				})
+			}
+			_ => Err(Message::Container("mp4 muxer: unsupported audio codec")),
+		}
+	})
+}
+
+/// Writes a descriptor header with a fixed 4-byte length (as FFmpeg does).
+fn put_descriptor(out: &mut Vec<u8>, tag: u8, len: usize) -> Result<()> {
+	if len >= 1 << 28 {
+		return Err(Message::Container("mp4 descriptor too large"));
+	}
+	out.put_u8(tag);
+	for shift in [21, 14, 7] {
+		out.put_u8(((len >> shift) & 0x7F) as u8 | 0x80);
+	}
+	out.put_u8((len & 0x7F) as u8);
+	Ok(())
+}
+
+fn write_esds(out: &mut Vec<u8>, p: &EntryParams, object_type: u8, stream_type: u8) -> Result<()> {
+	write_full_box(out, b"esds", 0, 0, |out| {
+		let dsi_len = if p.extradata.is_empty() { 0 } else { 5 + p.extradata.len() };
+		let decoder_config_len = 13 + dsi_len;
+		let es_len = 3 + (5 + decoder_config_len) + (5 + 1);
+		put_descriptor(out, 0x03, es_len)?;
+		out.put_u16(u16::try_from(p.track_id).unwrap_or(u16::MAX));
+		out.put_u8(0); // flags
+		put_descriptor(out, 0x04, decoder_config_len)?;
+		out.put_u8(object_type);
+		out.put_u8((stream_type << 2) | 1);
+		out.put_u24(p.buffer_size.min(0xFF_FFFF));
+		out.put_u32(p.max_bitrate);
+		out.put_u32(p.avg_bitrate);
+		if !p.extradata.is_empty() {
+			put_descriptor(out, 0x05, p.extradata.len())?;
+			out.put(p.extradata);
+		}
+		put_descriptor(out, 0x06, 1)?; // SLConfigDescriptor
+		out.put_u8(0x02); // predefined: MP4 file
+		Ok(())
+	})
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn asc_lc_stereo_44k() {
+		assert_eq!(parse_audio_specific_config(&[0x12, 0x10]), Some((44_100, 2)));
+	}
+
+	#[test]
+	fn esds_round_trip() {
+		let params = EntryParams {
+			codec: "aac",
+			kind: StreamKind::Audio,
+			width: 0,
+			height: 0,
+			sample_rate: 44_100,
+			channels: 2,
+			extradata: &[0x12, 0x10],
+			track_id: 1,
+			avg_bitrate: 128_000,
+			max_bitrate: 130_000,
+			buffer_size: 1024,
+		};
+		let mut out = Vec::new();
+		write_stsd(&mut out, &params).unwrap();
+		let stsd = super::super::boxes::find(&out, b"stsd").unwrap();
+		let info = parse_stsd(stsd, StreamKind::Audio).unwrap();
+		assert_eq!(info.codec, "aac");
+		assert_eq!(info.sample_rate, Some(44_100));
+		assert_eq!(info.channels, Some(2));
+		assert_eq!(info.extradata, vec![0x12, 0x10]);
+		assert_eq!(info.bitrate, Some(128_000));
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/demuxer.rs rmp/src/container/mp4/demuxer.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/demuxer.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/demuxer.rs	2026-11-02 17:39:08.780119365 -0700
@@ -0,0 +1,411 @@
+//! MP4 / M4A / MOV demuxer (non-fragmented ISO BMFF).
+//!
+//! Opening a file walks the top-level boxes until `moov`, loads it into
+//! memory, and builds a flat sample index per track
+//! ([`super::sample_table`]). Reading then returns samples from all tracks
+//! interleaved by decode time, seeking to each sample's offset in `mdat`.
+//! This follows FFmpeg's `mov.c` (`mov_read_header` + `mov_read_packet`).
+
+use super::boxes::{BoxIter, find, find_path, full_box};
+use super::codec::{self, CodecInfo};
+use super::metadata;
+use super::sample_table::{self, Sample};
+use crate::core::{
+	CodecId, Demuxer, Metadata, Packet, Parameters, RawValue, Stream, StreamId, StreamKind,
+	StreamSet, Time, TimeBase,
+};
+use crate::io::{BufferedReader, ByteCursor, Io};
+use crate::message::{Message, Result};
+
+/// Largest `moov` box we are willing to load (sample tables of very long
+/// files are a few tens of MB; anything far larger is corrupt).
+const MAX_MOOV_SIZE: u64 = 256 * 1024 * 1024;
+
+/// Stream metadata keys for audio priming / trailing padding (in samples),
+/// derived from the edit list. Same keys as the MP3 demuxer uses, so audio
+/// gapless information survives MP3 → MP4 and MP4 → MP4 remuxing.
+pub const ENCODER_DELAY_KEY: &str = "encoder_delay";
+pub const ENCODER_PADDING_KEY: &str = "encoder_padding";
+
+/// First real edit of an edit list.
+#[derive(Debug, Clone, Copy, Default)]
+struct Edit {
+	/// Presentation shift in media ticks (empty-edit delay − media time).
+	shift: i64,
+	media_time: i64,
+	/// Duration of the edit in media ticks (0 = unknown / whole track).
+	segment: u64,
+}
+
+struct Track {
+	timescale: u32,
+	samples: Vec<Sample>,
+	/// Index of the next sample to return.
+	next: usize,
+	/// Presentation shift from the edit list, in track ticks.
+	pts_shift: i64,
+	has_sync_table: bool,
+}
+
+pub struct Mp4Demuxer {
+	reader: BufferedReader,
+	metadata: Metadata,
+	streams: StreamSet,
+	tracks: Vec<Track>,
+	duration: Time,
+}
+
+/// Locates and loads the `moov` box, scanning top-level boxes.
+fn load_moov(reader: &mut BufferedReader) -> Result<Vec<u8>> {
+	let file_size = reader.size();
+	loop {
+		let position = reader.position();
+		let head = reader.fill(16)?;
+		if head.len() < 8 {
+			return Err(Message::Container("mp4 moov box not found"));
+		}
+		let mut c = ByteCursor::new(head);
+		let size32 = c.read_u32()?;
+		let kind = c.read_fourcc()?;
+		let (size, header) = match size32 {
+			0 => match file_size {
+				Some(total) => (total.saturating_sub(position), 8),
+				None => return Err(Message::Container("mp4 moov box not found")),
+			},
+			1 => (c.read_u64()?, 16),
+			n => (u64::from(n), 8),
+		};
+		if size < header {
+			return Err(Message::Container("invalid mp4 box size"));
+		}
+		match &kind {
+			b"moov" => {
+				let body = size - header;
+				if body > MAX_MOOV_SIZE {
+					return Err(Message::Container("mp4 moov box too large"));
+				}
+				reader.skip(header)?;
+				return reader.read_vec(body as usize);
+			}
+			_ => {
+				let next = position.checked_add(size).ok_or(Message::Container("invalid mp4 box size"))?;
+				if file_size.is_some_and(|total| next >= total) {
+					return Err(Message::Container("mp4 moov box not found"));
+				}
+				reader.seek(next)?;
+			}
+		}
+	}
+}
+
+/// Parses `mvhd` → (timescale, duration).
+fn parse_mvhd(body: &[u8]) -> Result<(u32, u64)> {
+	let (version, _, payload) = full_box(body)?;
+	let mut c = ByteCursor::new(payload);
+	if version == 1 {
+		c.skip(16)?;
+		Ok((c.read_u32()?, c.read_u64()?))
+	} else {
+		c.skip(8)?;
+		Ok((c.read_u32()?, u64::from(c.read_u32()?)))
+	}
+}
+
+/// Parses `mdhd` → (timescale, duration, ISO-639-2 language).
+fn parse_mdhd(body: &[u8]) -> Result<(u32, u64, Option<String>)> {
+	let (version, _, payload) = full_box(body)?;
+	let mut c = ByteCursor::new(payload);
+	let (timescale, duration) = if version == 1 {
+		c.skip(16)?;
+		(c.read_u32()?, c.read_u64()?)
+	} else {
+		c.skip(8)?;
+		(c.read_u32()?, u64::from(c.read_u32()?))
+	};
+	let packed = c.read_u16().unwrap_or(0);
+	let language: String = [10u16, 5, 0]
+		.iter()
+		.map(|shift| char::from((((packed >> shift) & 0x1F) as u8) + 0x60))
+		.collect();
+	let language = Some(language).filter(|l| l != "und" && l.chars().all(|c| c.is_ascii_lowercase()));
+	Ok((timescale, duration, language))
+}
+
+fn parse_handler(hdlr: &[u8]) -> StreamKind {
+	match hdlr.get(8..12) {
+		Some(b"vide") => StreamKind::Video,
+		Some(b"soun") => StreamKind::Audio,
+		Some(b"sbtl" | b"subt" | b"text") => StreamKind::Subtitle,
+		_ => StreamKind::Other,
+	}
+}
+
+/// Interprets the edit list as a single presentation shift (in media
+/// ticks): leading empty edits delay the track, the first real edit's
+/// media time skips into it.
+fn parse_edit_list(trak: &[u8], movie_timescale: u32, media_timescale: u32) -> Edit {
+	let none = Edit::default();
+	let Some(elst) = find_path(trak, &[b"edts", b"elst"]) else { return none };
+	let Ok((version, _, payload)) = full_box(elst) else { return none };
+	let mut c = ByteCursor::new(payload);
+	let Ok(count) = c.read_u32() else { return none };
+	let to_media = |ticks: u64| {
+		if movie_timescale == 0 {
+			return 0;
+		}
+		crate::core::rescale_ticks(
+			ticks,
+			TimeBase::new(1, movie_timescale),
+			TimeBase::new(1, media_timescale),
+		)
+		.unwrap_or(0)
+	};
+	let mut empty_ticks: u64 = 0;
+	for _ in 0..count.min(1024) {
+		let entry = if version == 1 {
+			c.read_u64().and_then(|d| c.read_u64().map(|m| (d, m as i64)))
+		} else {
+			c.read_u32().and_then(|d| c.read_i32().map(|m| (u64::from(d), i64::from(m))))
+		};
+		let Ok((segment_duration, media_time)) = entry else { break };
+		if c.skip(4).is_err() {
+			break; // media rate
+		}
+		if media_time == -1 {
+			empty_ticks = empty_ticks.saturating_add(segment_duration);
+			continue;
+		}
+		let delay = i64::try_from(to_media(empty_ticks)).unwrap_or(0);
+		return Edit {
+			shift: delay.saturating_sub(media_time),
+			media_time,
+			segment: to_media(segment_duration),
+		};
+	}
+	none
+}
+
+fn build_stream(index: usize, kind: StreamKind, timescale: u32, info: CodecInfo) -> Stream {
+	let parameters = Parameters {
+		codec: CodecId::new(&info.codec),
+		profile: None,
+		bitrate: info.bitrate,
+		sample_rate: info.sample_rate,
+		channels: info.channels,
+		width: info.width,
+		height: info.height,
+		pixel_format: None,
+		extradata: info.extradata,
+	};
+	Stream {
+		id: StreamId(index),
+		kind,
+		time_base: TimeBase::new(1, timescale),
+		duration: None,
+		parameters,
+		metadata: Metadata::default(),
+	}
+}
+
+impl Mp4Demuxer {
+	pub fn new(io: Box<dyn Io>) -> Result<Self> {
+		let mut reader = BufferedReader::new(io);
+		let file_size = reader.size();
+		let moov = load_moov(&mut reader)?;
+
+		let mvhd = find(&moov, b"mvhd").ok_or(Message::Container("mp4 mvhd box not found"))?;
+		let (movie_timescale, movie_duration) = parse_mvhd(mvhd)?;
+
+		let mut streams = StreamSet::default();
+		let mut tracks = Vec::new();
+		for (kind, trak) in BoxIter::new(&moov).map_while(|r| r.ok()) {
+			if &kind != b"trak" {
+				continue;
+			}
+			// A malformed track is skipped rather than failing the file,
+			// so the remaining tracks stay playable.
+			let Ok(Some((stream, track))) =
+				Self::parse_track(trak, tracks.len(), movie_timescale, file_size)
+			else {
+				continue;
+			};
+			streams.add(stream);
+			tracks.push(track);
+		}
+		if tracks.is_empty() {
+			return Err(if find(&moov, b"mvex").is_some() {
+				Message::Container("fragmented mp4 is not supported")
+			} else {
+				Message::Container("mp4 file has no playable tracks")
+			});
+		}
+
+		let mut metadata = Metadata::default();
+		metadata::parse_moov_metadata(&moov, &mut metadata);
+
+		let duration = if movie_timescale > 0 {
+			Time::new(movie_duration, TimeBase::new(1, movie_timescale))
+		} else {
+			streams
+				.iter()
+				.filter_map(|s| s.duration)
+				.max_by(|a, b| a.as_seconds().total_cmp(&b.as_seconds()))
+				.unwrap_or(Time::zero(TimeBase::new(1, 1000)))
+		};
+
+		Ok(Self { reader, metadata, streams, tracks, duration })
+	}
+
+	fn parse_track(
+		trak: &[u8],
+		index: usize,
+		movie_timescale: u32,
+		file_size: Option<u64>,
+	) -> Result<Option<(Stream, Track)>> {
+		let Some(mdia) = find(trak, b"mdia") else { return Ok(None) };
+		let mdhd = find(mdia, b"mdhd").ok_or(Message::Container("mp4 mdhd box not found"))?;
+		let (timescale, media_duration, language) = parse_mdhd(mdhd)?;
+		if timescale == 0 {
+			return Err(Message::Container("mp4 track timescale is zero"));
+		}
+		let kind = find(mdia, b"hdlr").map_or(StreamKind::Other, parse_handler);
+		let stbl = find_path(mdia, &[b"minf", b"stbl"])
+			.ok_or(Message::Container("mp4 sample table not found"))?;
+		let info = match find(stbl, b"stsd") {
+			Some(stsd) => codec::parse_stsd(stsd, kind)?,
+			None => return Ok(None),
+		};
+		let samples = sample_table::build_index(stbl, file_size)?;
+		if samples.is_empty() {
+			return Ok(None);
+		}
+
+		let edit = parse_edit_list(trak, movie_timescale, timescale);
+		let mut stream = build_stream(index, kind, timescale, info);
+		stream.duration = Some(Time::new(media_duration, stream.time_base));
+		if let Some(language) = language {
+			stream.metadata.raw.insert("language".into(), RawValue::String(language));
+		}
+
+		// Timestamps are unsigned, so audio priming (a negative shift that
+		// would push the first packets before zero) is exposed as metadata
+		// instead, mirroring how the MP3 demuxer reports encoder delay.
+		let pts_shift = if kind == StreamKind::Audio && edit.shift < 0 {
+			let raw = &mut stream.metadata.raw;
+			raw.insert(ENCODER_DELAY_KEY.into(), RawValue::String(edit.media_time.to_string()));
+			let used = (edit.media_time as u64).saturating_add(edit.segment);
+			if edit.segment > 0 && used < media_duration {
+				let padding = media_duration - used;
+				raw.insert(ENCODER_PADDING_KEY.into(), RawValue::String(padding.to_string()));
+			}
+			0
+		} else {
+			edit.shift
+		};
+
+		let has_sync_table = find(stbl, b"stss").is_some();
+		Ok(Some((stream, Track { timescale, samples, next: 0, pts_shift, has_sync_table })))
+	}
+
+	/// Track whose next sample has the smallest decode time (ties broken by
+	/// file offset, which minimises seeking).
+	fn next_track(&self) -> Option<usize> {
+		let mut best: Option<(usize, &Sample, u32)> = None;
+		for (index, track) in self.tracks.iter().enumerate() {
+			let Some(sample) = track.samples.get(track.next) else { continue };
+			let better = match best {
+				None => true,
+				Some((_, other, other_scale)) => {
+					// Compare dts_a / scale_a with dts_b / scale_b exactly.
+					let a = u128::from(sample.dts) * u128::from(other_scale);
+					let b = u128::from(other.dts) * u128::from(track.timescale);
+					a < b || (a == b && sample.offset < other.offset)
+				}
+			};
+			if better {
+				best = Some((index, sample, track.timescale));
+			}
+		}
+		best.map(|(index, _, _)| index)
+	}
+}
+
+fn shifted(ticks: u64, shift: i64) -> u64 {
+	if shift >= 0 {
+		ticks.saturating_add(shift as u64)
+	} else {
+		ticks.saturating_sub(shift.unsigned_abs())
+	}
+}
+
+impl Demuxer for Mp4Demuxer {
+	fn read(&mut self) -> Result<Option<Packet>> {
+		let Some(index) = self.next_track() else { return Ok(None) };
+		let track = &mut self.tracks[index];
+		let sample = track.samples[track.next];
+		track.next += 1;
+		let time_base = TimeBase::new(1, track.timescale);
+
+		let dts = if track.pts_shift > 0 { shifted(sample.dts, track.pts_shift) } else { sample.dts };
+		let pts = shifted(sample.dts, i64::from(sample.cts).saturating_add(track.pts_shift));
+
+		if self.reader.position() != sample.offset {
+			self.reader.seek(sample.offset)?;
+		}
+		let data = self.reader.read_vec(sample.size as usize)?;
+
+		Ok(Some(Packet {
+			stream_id: StreamId(index),
+			data,
+			pts: Some(Time::new(pts, time_base)),
+			dts: Some(Time::new(dts, time_base)),
+			duration: Some(Time::new(u64::from(sample.duration), time_base)),
+			keyframe: sample.keyframe,
+		}))
+	}
+
+	/// Seeks every track so that playback can start at `time`: tracks with
+	/// sync-sample tables (video) snap back to the preceding keyframe, and
+	/// all other tracks are aligned to that keyframe's time, as FFmpeg does.
+	fn seek(&mut self, time: f64) -> Result<()> {
+		if !time.is_finite() || time < 0.0 {
+			return Err(Message::Other("invalid seek time"));
+		}
+		let locate = |track: &Track, seconds: f64| -> usize {
+			let target = (seconds * f64::from(track.timescale)) as u64;
+			track.samples.partition_point(|s| s.dts <= target).saturating_sub(1)
+		};
+
+		let mut start = time;
+		for track in self.tracks.iter().filter(|t| t.has_sync_table) {
+			let mut i = locate(track, time);
+			while i > 0 && !track.samples[i].keyframe {
+				i -= 1;
+			}
+			let seconds = track.samples[i].dts as f64 / f64::from(track.timescale);
+			start = start.min(seconds);
+		}
+		for track in self.tracks.iter_mut() {
+			let mut i = locate(track, start);
+			if track.has_sync_table {
+				while i > 0 && !track.samples[i].keyframe {
+					i -= 1;
+				}
+			}
+			track.next = i;
+		}
+		Ok(())
+	}
+
+	fn duration(&self) -> Time {
+		self.duration
+	}
+
+	fn metadata(&self) -> &Metadata {
+		&self.metadata
+	}
+
+	fn streams(&self) -> &StreamSet {
+		&self.streams
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/metadata.rs rmp/src/container/mp4/metadata.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/metadata.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/metadata.rs	2026-11-02 17:39:08.780119365 -0700
@@ -0,0 +1,200 @@
+//! iTunes-style metadata (`moov/udta/meta/ilst`), as read by FFmpeg's
+//! `mov_read_udta_string` and written by `mov_write_ilst_tag`.
+
+use super::boxes::{
+	BoxIter, FourCC, Put, begin_box, end_box, find, fourcc_string, write_box, write_full_box,
+};
+use crate::container::mp3::id3::ID3V1_GENRES;
+use crate::core::{AttachedImage, Metadata, RawValue};
+use crate::io::ByteCursor;
+use crate::message::Result;
+
+/// `data` box well-known types.
+const TYPE_UTF8: u32 = 1;
+const TYPE_JPEG: u32 = 13;
+const TYPE_PNG: u32 = 14;
+const TYPE_BMP: u32 = 27;
+const TYPE_INTEGER: u32 = 21;
+
+/// Reads `moov/udta` (and a bare `moov/meta`) into `metadata`.
+pub fn parse_moov_metadata(moov: &[u8], metadata: &mut Metadata) {
+	if let Some(meta) = find(moov, b"udta").and_then(|udta| find(udta, b"meta")) {
+		parse_meta(meta, metadata);
+	}
+	if let Some(meta) = find(moov, b"meta") {
+		parse_meta(meta, metadata);
+	}
+}
+
+fn parse_meta(meta: &[u8], metadata: &mut Metadata) {
+	// ISO `meta` is a full box; QuickTime's is not. Tell them apart by
+	// checking whether a box header starts right away.
+	let body = if meta.get(4..8) == Some(b"hdlr") { meta } else { meta.get(4..).unwrap_or(&[]) };
+	let Some(ilst) = find(body, b"ilst") else { return };
+	for (kind, item) in BoxIter::new(ilst).map_while(|r| r.ok()) {
+		parse_item(&kind, item, metadata);
+	}
+}
+
+/// Each item holds one or more `data` boxes: type(4) locale(4) value.
+fn data_values(item: &[u8]) -> impl Iterator<Item = (u32, &[u8])> {
+	BoxIter::new(item).map_while(|r| r.ok()).filter(|(k, _)| k == b"data").filter_map(|(_, body)| {
+		let type_code = u32::from_be_bytes(body.get(..4)?.try_into().ok()?) & 0x00FF_FFFF;
+		Some((type_code, body.get(8..)?))
+	})
+}
+
+fn number_pair(value: &[u8]) -> (Option<u32>, Option<u32>) {
+	let mut c = ByteCursor::new(value);
+	let _ = c.skip(2);
+	let n = c.read_u16().ok().map(u32::from).filter(|&v| v > 0);
+	let total = c.read_u16().ok().map(u32::from).filter(|&v| v > 0);
+	(n, total)
+}
+
+fn integer(value: &[u8]) -> Option<i64> {
+	match value.len() {
+		1 => Some(i64::from(value[0] as i8)),
+		2 => Some(i64::from(i16::from_be_bytes([value[0], value[1]]))),
+		4 => Some(i64::from(i32::from_be_bytes([value[0], value[1], value[2], value[3]]))),
+		8 => Some(i64::from_be_bytes(value.try_into().ok()?)),
+		_ => None,
+	}
+}
+
+fn parse_item(kind: &FourCC, item: &[u8], metadata: &mut Metadata) {
+	if kind == b"----" {
+		// Freeform: mean / name / data.
+		let name = find(item, b"name").and_then(|n| n.get(4..)).map(|n| String::from_utf8_lossy(n));
+		let value = data_values(item).next();
+		if let (Some(name), Some((_, value))) = (name, value) {
+			let value = String::from_utf8_lossy(value).into_owned();
+			metadata.raw.insert(name.into_owned(), RawValue::String(value));
+		}
+		return;
+	}
+	for (type_code, value) in data_values(item) {
+		let text = || String::from_utf8_lossy(value).trim_end_matches('\0').to_string();
+		match kind {
+			b"\xa9nam" => metadata.title = Some(text()),
+			b"\xa9ART" => metadata.artist = Some(text()),
+			b"aART" => metadata.album_artist = Some(text()),
+			b"\xa9alb" => metadata.album = Some(text()),
+			b"\xa9gen" => metadata.genre = Some(text()),
+			b"\xa9day" => metadata.date = Some(text()),
+			b"\xa9cmt" => metadata.comment = Some(text()),
+			b"\xa9lyr" => metadata.lyrics = Some(text()),
+			b"desc" => metadata.description = Some(text()),
+			b"trkn" => (metadata.track_number, metadata.tracks_total) = number_pair(value),
+			b"disk" => (metadata.disc_number, metadata.discs_total) = number_pair(value),
+			b"gnre" => {
+				let index = integer(value).and_then(|g| usize::try_from(g - 1).ok());
+				if let Some(name) = index.and_then(|i| ID3V1_GENRES.get(i)) {
+					metadata.genre = Some((*name).to_string());
+				}
+			}
+			b"covr" => {
+				let mime_type = match type_code {
+					TYPE_PNG => "image/png",
+					TYPE_BMP => "image/bmp",
+					_ => "image/jpeg",
+				};
+				metadata.images.push(AttachedImage {
+					data: value.to_vec(),
+					mime_type: mime_type.into(),
+					description: None,
+				});
+			}
+			_ => {
+				let value = if type_code == TYPE_INTEGER || (type_code == 0 && value.len() <= 8) {
+					match integer(value) {
+						Some(v) => v.to_string(),
+						None => text(),
+					}
+				} else {
+					text()
+				};
+				metadata.raw.insert(fourcc_string(kind), RawValue::String(value));
+			}
+		}
+	}
+}
+
+fn write_data(out: &mut Vec<u8>, type_code: u32, value: &[u8]) -> Result<()> {
+	write_box(out, b"data", |out| {
+		out.put_u32(type_code);
+		out.put_u32(0); // locale
+		out.put(value);
+		Ok(())
+	})
+}
+
+fn write_text_item(out: &mut Vec<u8>, kind: &FourCC, value: Option<&str>) -> Result<()> {
+	match value.filter(|v| !v.is_empty()) {
+		Some(value) => write_box(out, kind, |out| write_data(out, TYPE_UTF8, value.as_bytes())),
+		None => Ok(()),
+	}
+}
+
+fn write_pair_item(
+	out: &mut Vec<u8>,
+	kind: &FourCC,
+	n: Option<u32>,
+	total: Option<u32>,
+) -> Result<()> {
+	let Some(n) = n else { return Ok(()) };
+	let clamp = |v: u32| u16::try_from(v).unwrap_or(u16::MAX);
+	let mut value = Vec::with_capacity(8);
+	value.put_u16(0);
+	value.put_u16(clamp(n));
+	value.put_u16(total.map_or(0, clamp));
+	if kind == b"trkn" {
+		value.put_u16(0);
+	}
+	write_box(out, kind, |out| write_data(out, 0, &value))
+}
+
+/// Writes `udta/meta/ilst` for `metadata`; writes nothing when empty.
+pub fn write_udta(out: &mut Vec<u8>, metadata: &Metadata, encoder: &str) -> Result<()> {
+	let mut ilst = Vec::new();
+	write_text_item(&mut ilst, b"\xa9nam", metadata.title.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9ART", metadata.artist.as_deref())?;
+	write_text_item(&mut ilst, b"aART", metadata.album_artist.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9alb", metadata.album.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9gen", metadata.genre.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9day", metadata.date.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9cmt", metadata.comment.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9lyr", metadata.lyrics.as_deref())?;
+	write_text_item(&mut ilst, b"desc", metadata.description.as_deref())?;
+	write_text_item(&mut ilst, b"\xa9too", Some(encoder))?;
+	write_pair_item(&mut ilst, b"trkn", metadata.track_number, metadata.tracks_total)?;
+	write_pair_item(&mut ilst, b"disk", metadata.disc_number, metadata.discs_total)?;
+	if !metadata.images.is_empty() {
+		write_box(&mut ilst, b"covr", |out| {
+			for image in &metadata.images {
+				let type_code = match image.mime_type.as_str() {
+					"image/png" => TYPE_PNG,
+					"image/bmp" => TYPE_BMP,
+					_ => TYPE_JPEG,
+				};
+				write_data(out, type_code, &image.data)?;
+			}
+			Ok(())
+		})?;
+	}
+
+	write_box(out, b"udta", |out| {
+		write_full_box(out, b"meta", 0, 0, |out| {
+			write_full_box(out, b"hdlr", 0, 0, |out| {
+				out.put_u32(0);
+				out.put(b"mdir");
+				out.put(b"appl");
+				out.put_zeros(9);
+				Ok(())
+			})?;
+			let at = begin_box(out, b"ilst");
+			out.put(&ilst);
+			end_box(out, at)
+		})
+	})
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/mod.rs rmp/src/container/mp4/mod.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/mod.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/mod.rs	2026-11-02 17:29:11.507884219 -0700
@@ -0,0 +1,13 @@
+//! MP4 / M4A container (ISO/IEC 14496-12 and -14), plus the QuickTime
+//! variations commonly found in `.mov`/`.m4a` files.
+//!
+//! See `docs/MP3_MP4.md` for the format walkthrough.
+
+pub mod boxes;
+pub mod codec;
+pub mod demuxer;
+pub mod metadata;
+pub mod muxer;
+pub mod probe;
+pub mod sample_table;
+pub use probe::*;
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/muxer.rs rmp/src/container/mp4/muxer.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/container/mp4/muxer.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/container/mp4/muxer.rs	2026-11-02 17:39:08.788119366 -0700
@@ -0,0 +1,582 @@
+//! MP4 muxer (ISO BMFF, `moov` at the end, like FFmpeg's `movenc.c` without
+//! `+faststart`).
+//!
+//! ```text
+//! ftyp | mdat (64-bit size, patched in finish) | moov
+//! ```
+//!
+//! Packets are appended to `mdat` as they arrive; consecutive packets of the
+//! same track form a chunk. Per-sample bookkeeping (size, dts, composition
+//! offset, keyframe flag) is kept in memory and serialised into the sample
+//! tables when [`Muxer::finish`] writes `moov`.
+
+use super::boxes::{Put, write_box, write_full_box};
+use super::codec::{self, EntryParams};
+use super::demuxer::{ENCODER_DELAY_KEY, ENCODER_PADDING_KEY};
+use super::metadata;
+use crate::codecs::mp3::FrameHeader;
+use crate::core::{
+	Metadata, Muxer, Packet, RawValue, Stream, StreamId, StreamKind, Time, TimeBase, rescale_ticks,
+};
+use crate::io::Io;
+use crate::message::{Message, Result};
+
+/// Timescale of `mvhd`/`tkhd`/`elst` durations.
+const MOVIE_TIMESCALE: u32 = 1000;
+/// Size of the `mdat` header we write (32-bit size = 1, then 64-bit size).
+const MDAT_HEADER_SIZE: u64 = 16;
+const ENCODER_NAME: &str = "RMP";
+
+const IDENTITY_MATRIX: [u32; 9] = [0x0001_0000, 0, 0, 0, 0x0001_0000, 0, 0, 0, 0x4000_0000];
+
+struct MuxSample {
+	size: u32,
+	dts: u64,
+	/// pts - dts, in track ticks.
+	cts: i64,
+	keyframe: bool,
+}
+
+struct Chunk {
+	offset: u64,
+	samples: u32,
+}
+
+struct MuxTrack {
+	stream_id: StreamId,
+	kind: StreamKind,
+	codec: String,
+	track_id: u32,
+	timescale: u32,
+	width: u32,
+	height: u32,
+	sample_rate: u32,
+	channels: u8,
+	extradata: Vec<u8>,
+	/// Audio priming / trailing padding to signal through an edit list,
+	/// in track ticks.
+	encoder_delay: Option<u64>,
+	encoder_padding: u64,
+	samples: Vec<MuxSample>,
+	chunks: Vec<Chunk>,
+	/// Duration of the last packet, when the packet said so.
+	last_duration: Option<u64>,
+	/// dts to assign to a packet that carries no timestamps.
+	next_dts: u64,
+	bytes: u64,
+	max_sample_size: u32,
+}
+
+impl MuxTrack {
+	fn duration_of(&self, index: usize) -> u64 {
+		match self.samples.get(index + 1) {
+			Some(next) => next.dts.saturating_sub(self.samples[index].dts),
+			None => self.last_duration.unwrap_or_else(|| {
+				// Repeat the previous delta for the final sample.
+				index
+					.checked_sub(1)
+					.map_or(0, |prev| self.samples[index].dts.saturating_sub(self.samples[prev].dts))
+			}),
+		}
+	}
+
+	/// Total media duration in track ticks.
+	fn media_duration(&self) -> u64 {
+		match (self.samples.first(), self.samples.len().checked_sub(1)) {
+			(Some(first), Some(last)) => {
+				(self.samples[last].dts + self.duration_of(last)).saturating_sub(first.dts)
+			}
+			_ => 0,
+		}
+	}
+
+	/// Media time where presentation starts (edit list), if any.
+	fn edit_media_time(&self) -> Option<u64> {
+		match self.kind {
+			StreamKind::Audio => self.encoder_delay.filter(|&d| d > 0 && d < self.media_duration()),
+			_ => {
+				let first_pts =
+					self.samples.iter().map(|s| i128::from(s.dts) + i128::from(s.cts)).min().unwrap_or(0);
+				u64::try_from(first_pts).ok().filter(|&p| p > 0)
+			}
+		}
+	}
+
+	/// Presented duration in track ticks (media duration minus edits).
+	fn presentation_duration(&self) -> u64 {
+		let media = self.media_duration();
+		match self.edit_media_time() {
+			Some(start) => {
+				let padding = if self.kind == StreamKind::Audio { self.encoder_padding } else { 0 };
+				media.saturating_sub(start).saturating_sub(padding)
+			}
+			None => media,
+		}
+	}
+
+	fn to_movie(&self, ticks: u64) -> u64 {
+		rescale_ticks(ticks, TimeBase::new(1, self.timescale), TimeBase::new(1, MOVIE_TIMESCALE))
+			.unwrap_or(0)
+	}
+
+	/// Fallback packet duration for packets without any timing.
+	fn implicit_duration(&self, data: &[u8]) -> Option<u64> {
+		let samples = match self.codec.as_str() {
+			"aac" => 1024,
+			"mp3" => FrameHeader::parse(data)?.samples,
+			_ => return None,
+		};
+		rescale_ticks(
+			u64::from(samples),
+			TimeBase::new(1, self.sample_rate.max(1)),
+			TimeBase::new(1, self.timescale),
+		)
+	}
+}
+
+pub struct Mp4Muxer {
+	io: Box<dyn Io>,
+	metadata: Metadata,
+	tracks: Vec<MuxTrack>,
+	started: bool,
+	mdat_start: u64,
+	position: u64,
+	last_track: Option<usize>,
+}
+
+impl Mp4Muxer {
+	pub fn new(io: Box<dyn Io>) -> Self {
+		Self {
+			io,
+			metadata: Metadata::default(),
+			tracks: Vec::new(),
+			started: false,
+			mdat_start: 0,
+			position: 0,
+			last_track: None,
+		}
+	}
+
+	fn start(&mut self) -> Result<()> {
+		let mut header = Vec::with_capacity(64);
+		write_box(&mut header, b"ftyp", |out| {
+			out.put(b"isom");
+			out.put_u32(0x200);
+			out.put(b"isom");
+			out.put(b"iso2");
+			if self.tracks.iter().any(|t| t.codec == "h264") {
+				out.put(b"avc1");
+			}
+			out.put(b"mp41");
+			Ok(())
+		})?;
+		self.mdat_start = header.len() as u64;
+		header.put_u32(1); // 64-bit size follows
+		header.put(b"mdat");
+		header.put_u64(0); // patched in finish
+		self.io.write_all(&header)?;
+		self.position = header.len() as u64;
+		self.started = true;
+		Ok(())
+	}
+
+	fn timescale_for(stream: &Stream) -> Result<u32> {
+		if stream.kind == StreamKind::Audio {
+			let rate = stream.parameters.sample_rate.unwrap_or(0);
+			if rate > 0 {
+				return Ok(rate);
+			}
+		}
+		let den = stream.time_base.den;
+		if den == 0 || stream.time_base.num == 0 {
+			return Err(Message::Container("mp4 muxer: invalid stream time base"));
+		}
+		// Like FFmpeg, keep enough precision for video timestamps.
+		let mut timescale = den;
+		while timescale < 10_000 {
+			timescale = timescale.saturating_mul(2);
+		}
+		Ok(timescale)
+	}
+
+	fn to_track_ticks(time: Time, timescale: u32) -> Result<u64> {
+		time
+			.rescale(TimeBase::new(1, timescale))
+			.map(|t| t.ticks())
+			.ok_or(Message::Container("mp4 muxer: invalid packet timestamp"))
+	}
+
+	fn build_moov(&self) -> Result<Vec<u8>> {
+		let mut moov = Vec::new();
+		let movie_duration =
+			self.tracks.iter().map(|t| t.to_movie(t.presentation_duration())).max().unwrap_or(0);
+		write_box(&mut moov, b"moov", |out| {
+			write_mvhd(out, movie_duration, self.tracks.len() as u32 + 1)?;
+			for track in &self.tracks {
+				write_trak(out, track)?;
+			}
+			metadata::write_udta(out, &self.metadata, ENCODER_NAME)
+		})?;
+		Ok(moov)
+	}
+}
+
+/// Writes version 0 when every value fits 32 bits, version 1 otherwise.
+fn version_for(values: &[u64]) -> u8 {
+	u8::from(values.iter().any(|&v| v > u64::from(u32::MAX)))
+}
+
+fn put_time(out: &mut Vec<u8>, version: u8, value: u64) {
+	if version == 1 { out.put_u64(value) } else { out.put_u32(value as u32) }
+}
+
+fn write_mvhd(out: &mut Vec<u8>, duration: u64, next_track_id: u32) -> Result<()> {
+	let version = version_for(&[duration]);
+	write_full_box(out, b"mvhd", version, 0, |out| {
+		put_time(out, version, 0); // creation time
+		put_time(out, version, 0); // modification time
+		out.put_u32(MOVIE_TIMESCALE);
+		put_time(out, version, duration);
+		out.put_u32(0x0001_0000); // rate 1.0
+		out.put_u16(0x0100); // volume 1.0
+		out.put_zeros(10);
+		IDENTITY_MATRIX.iter().for_each(|&v| out.put_u32(v));
+		out.put_zeros(24); // pre_defined
+		out.put_u32(next_track_id);
+		Ok(())
+	})
+}
+
+fn write_trak(out: &mut Vec<u8>, track: &MuxTrack) -> Result<()> {
+	let media_duration = track.media_duration();
+	let movie_duration = track.to_movie(track.presentation_duration());
+	// Edit list: start presentation at the first composition time (B-frame
+	// delay) or after the audio priming samples.
+	let media_time = track.edit_media_time();
+
+	write_box(out, b"trak", |out| {
+		let version = version_for(&[movie_duration]);
+		write_full_box(out, b"tkhd", version, 0x3, |out| {
+			put_time(out, version, 0);
+			put_time(out, version, 0);
+			out.put_u32(track.track_id);
+			out.put_u32(0);
+			put_time(out, version, movie_duration);
+			out.put_zeros(8);
+			out.put_u16(0); // layer
+			out.put_u16(0); // alternate group
+			out.put_u16(if track.kind == StreamKind::Audio { 0x0100 } else { 0 });
+			out.put_u16(0);
+			IDENTITY_MATRIX.iter().for_each(|&v| out.put_u32(v));
+			out.put_u32(track.width << 16);
+			out.put_u32(track.height << 16);
+			Ok(())
+		})?;
+
+		if let Some(media_time) = media_time {
+			let segment = movie_duration;
+			let version = version_for(&[segment, media_time]);
+			write_box(out, b"edts", |out| {
+				write_full_box(out, b"elst", version, 0, |out| {
+					out.put_u32(1);
+					put_time(out, version, segment);
+					put_time(out, version, media_time);
+					out.put_u32(0x0001_0000); // rate 1.0
+					Ok(())
+				})
+			})?;
+		}
+
+		write_box(out, b"mdia", |out| {
+			let version = version_for(&[media_duration]);
+			write_full_box(out, b"mdhd", version, 0, |out| {
+				put_time(out, version, 0);
+				put_time(out, version, 0);
+				out.put_u32(track.timescale);
+				put_time(out, version, media_duration);
+				out.put_u16(0x55C4); // "und"
+				out.put_u16(0);
+				Ok(())
+			})?;
+			let (handler, name): (&[u8; 4], &[u8]) = match track.kind {
+				StreamKind::Video => (b"vide", b"VideoHandler\0"),
+				_ => (b"soun", b"SoundHandler\0"),
+			};
+			write_full_box(out, b"hdlr", 0, 0, |out| {
+				out.put_u32(0);
+				out.put(handler);
+				out.put_zeros(12);
+				out.put(name);
+				Ok(())
+			})?;
+			write_box(out, b"minf", |out| {
+				if track.kind == StreamKind::Video {
+					write_full_box(out, b"vmhd", 0, 1, |out| {
+						out.put_zeros(8);
+						Ok(())
+					})?;
+				} else {
+					write_full_box(out, b"smhd", 0, 0, |out| {
+						out.put_zeros(4);
+						Ok(())
+					})?;
+				}
+				write_box(out, b"dinf", |out| {
+					write_full_box(out, b"dref", 0, 0, |out| {
+						out.put_u32(1);
+						write_full_box(out, b"url ", 0, 1, |_| Ok(()))
+					})
+				})?;
+				write_stbl(out, track)
+			})
+		})
+	})
+}
+
+fn write_stbl(out: &mut Vec<u8>, track: &MuxTrack) -> Result<()> {
+	let seconds = track.media_duration() as f64 / f64::from(track.timescale);
+	let avg_bitrate = if seconds > 0.0 { (track.bytes as f64 * 8.0 / seconds) as u32 } else { 0 };
+	let params = EntryParams {
+		codec: &track.codec,
+		kind: track.kind,
+		width: track.width,
+		height: track.height,
+		sample_rate: track.sample_rate,
+		channels: track.channels,
+		extradata: &track.extradata,
+		track_id: track.track_id,
+		avg_bitrate,
+		max_bitrate: avg_bitrate,
+		buffer_size: track.max_sample_size,
+	};
+
+	write_box(out, b"stbl", |out| {
+		codec::write_stsd(out, &params)?;
+
+		// stts: run-length decode-time deltas.
+		let mut stts: Vec<(u32, u64)> = Vec::new();
+		for i in 0..track.samples.len() {
+			let delta = track.duration_of(i);
+			match stts.last_mut() {
+				Some((count, d)) if *d == delta && *count < u32::MAX => *count += 1,
+				_ => stts.push((1, delta)),
+			}
+		}
+		write_full_box(out, b"stts", 0, 0, |out| {
+			out.put_u32(stts.len() as u32);
+			for &(count, delta) in &stts {
+				out.put_u32(count);
+				out.put_u32(u32::try_from(delta).unwrap_or(u32::MAX));
+			}
+			Ok(())
+		})?;
+
+		// ctts: only when some sample is displayed out of decode order.
+		if track.samples.iter().any(|s| s.cts != 0) {
+			let mut ctts: Vec<(u32, i64)> = Vec::new();
+			for sample in &track.samples {
+				match ctts.last_mut() {
+					Some((count, offset)) if *offset == sample.cts && *count < u32::MAX => *count += 1,
+					_ => ctts.push((1, sample.cts)),
+				}
+			}
+			let version = u8::from(ctts.iter().any(|&(_, o)| o < 0));
+			write_full_box(out, b"ctts", version, 0, |out| {
+				out.put_u32(ctts.len() as u32);
+				for &(count, offset) in &ctts {
+					out.put_u32(count);
+					out.put_i32(offset.clamp(i64::from(i32::MIN), i64::from(i32::MAX)) as i32);
+				}
+				Ok(())
+			})?;
+		}
+
+		// stss: only for video with non-key samples.
+		if track.kind == StreamKind::Video && track.samples.iter().any(|s| !s.keyframe) {
+			let sync: Vec<u32> =
+				(1u32..).zip(&track.samples).filter(|(_, s)| s.keyframe).map(|(n, _)| n).collect();
+			write_full_box(out, b"stss", 0, 0, |out| {
+				out.put_u32(sync.len() as u32);
+				sync.iter().for_each(|&n| out.put_u32(n));
+				Ok(())
+			})?;
+		}
+
+		// stsc: run-length samples-per-chunk.
+		let mut stsc: Vec<(u32, u32)> = Vec::new();
+		for (chunk, number) in track.chunks.iter().zip(1u32..) {
+			if stsc.last().is_none_or(|&(_, per_chunk)| per_chunk != chunk.samples) {
+				stsc.push((number, chunk.samples));
+			}
+		}
+		write_full_box(out, b"stsc", 0, 0, |out| {
+			out.put_u32(stsc.len() as u32);
+			for &(first_chunk, per_chunk) in &stsc {
+				out.put_u32(first_chunk);
+				out.put_u32(per_chunk);
+				out.put_u32(1); // sample description index
+			}
+			Ok(())
+		})?;
+
+		// stsz: constant size when possible.
+		let constant = track
+			.samples
+			.first()
+			.map(|s| s.size)
+			.filter(|&size| track.samples.iter().all(|s| s.size == size));
+		write_full_box(out, b"stsz", 0, 0, |out| {
+			out.put_u32(constant.unwrap_or(0));
+			out.put_u32(track.samples.len() as u32);
+			if constant.is_none() {
+				track.samples.iter().for_each(|s| out.put_u32(s.size));
+			}
+			Ok(())
+		})?;
+
+		// stco, or co64 once offsets pass 4 GiB.
+		if track.chunks.iter().any(|c| c.offset > u64::from(u32::MAX)) {
+			write_full_box(out, b"co64", 0, 0, |out| {
+				out.put_u32(track.chunks.len() as u32);
+				track.chunks.iter().for_each(|c| out.put_u64(c.offset));
+				Ok(())
+			})
+		} else {
+			write_full_box(out, b"stco", 0, 0, |out| {
+				out.put_u32(track.chunks.len() as u32);
+				track.chunks.iter().for_each(|c| out.put_u32(c.offset as u32));
+				Ok(())
+			})
+		}
+	})
+}
+
+impl Muxer for Mp4Muxer {
+	fn set_metadata(&mut self, metadata: Metadata) -> Result<()> {
+		self.metadata = metadata;
+		Ok(())
+	}
+
+	fn metadata(&self) -> &Metadata {
+		&self.metadata
+	}
+
+	fn add(&mut self, stream: &Stream) -> Result<usize> {
+		if self.started {
+			return Err(Message::Container("mp4 muxer: streams must be added before writing"));
+		}
+		if self.tracks.iter().any(|t| t.stream_id == stream.id) {
+			return Err(Message::Container("mp4 muxer: duplicate stream id"));
+		}
+		if !matches!(stream.kind, StreamKind::Audio | StreamKind::Video) {
+			return Err(Message::Container("mp4 muxer supports only audio and video streams"));
+		}
+		let p = &stream.parameters;
+		if !codec::muxer_supports(&p.codec.id) {
+			return Err(Message::Container("mp4 muxer: unsupported codec"));
+		}
+		let timescale = Self::timescale_for(stream)?;
+		let sample_rate = p.sample_rate.unwrap_or(0);
+		let samples_key = |key: &str| match stream.metadata.raw.get(key) {
+			Some(RawValue::String(v)) => v.parse::<u64>().ok().and_then(|d| {
+				rescale_ticks(d, TimeBase::new(1, sample_rate.max(1)), TimeBase::new(1, timescale))
+			}),
+			_ => None,
+		};
+		let encoder_delay = samples_key(ENCODER_DELAY_KEY);
+		let encoder_padding = samples_key(ENCODER_PADDING_KEY).unwrap_or(0);
+		self.tracks.push(MuxTrack {
+			stream_id: stream.id,
+			kind: stream.kind,
+			codec: p.codec.id.clone(),
+			track_id: self.tracks.len() as u32 + 1,
+			timescale,
+			width: p.width.unwrap_or(0),
+			height: p.height.unwrap_or(0),
+			sample_rate,
+			channels: p.channels.unwrap_or(0),
+			extradata: p.extradata.clone(),
+			encoder_delay,
+			encoder_padding,
+			samples: Vec::new(),
+			chunks: Vec::new(),
+			last_duration: None,
+			next_dts: 0,
+			bytes: 0,
+			max_sample_size: 0,
+		});
+		Ok(self.tracks.len() - 1)
+	}
+
+	fn write(&mut self, packet: Packet) -> Result<()> {
+		let index = self
+			.tracks
+			.iter()
+			.position(|t| t.stream_id == packet.stream_id)
+			.ok_or(Message::Container("mp4 muxer: packet for unknown stream"))?;
+		if !self.started {
+			self.start()?;
+		}
+		let size = u32::try_from(packet.data.len())
+			.map_err(|_| Message::Container("mp4 muxer: packet too large"))?;
+
+		let track = &mut self.tracks[index];
+		let timescale = track.timescale;
+		let duration = match packet.duration {
+			Some(d) => Some(Self::to_track_ticks(d, timescale)?),
+			None => None,
+		};
+		let dts = match packet.dts.or(packet.pts) {
+			Some(t) => Self::to_track_ticks(t, timescale)?,
+			None if !track.samples.is_empty() || duration.is_some() => track.next_dts,
+			None => match track.implicit_duration(&packet.data) {
+				Some(_) => track.next_dts,
+				None => return Err(Message::Container("mp4 muxer: packet has no timestamps")),
+			},
+		};
+		let pts = match packet.pts {
+			Some(t) => Self::to_track_ticks(t, timescale)?,
+			None => dts,
+		};
+		if track.samples.last().is_some_and(|last| dts < last.dts) {
+			return Err(Message::Container("mp4 muxer: non-monotonic dts"));
+		}
+		let step = duration.or_else(|| track.implicit_duration(&packet.data));
+		track.last_duration = step;
+		track.next_dts = dts.saturating_add(step.unwrap_or(0));
+		track.samples.push(MuxSample {
+			size,
+			dts,
+			cts: (i128::from(pts) - i128::from(dts)).clamp(i128::from(i64::MIN), i128::from(i64::MAX))
+				as i64,
+			keyframe: packet.keyframe,
+		});
+		track.bytes += u64::from(size);
+		track.max_sample_size = track.max_sample_size.max(size);
+
+		let continues_chunk = self.last_track == Some(index);
+		match track.chunks.last_mut() {
+			Some(chunk) if continues_chunk => chunk.samples += 1,
+			_ => track.chunks.push(Chunk { offset: self.position, samples: 1 }),
+		}
+		self.last_track = Some(index);
+
+		self.io.write_all(&packet.data)?;
+		self.position += u64::from(size);
+		Ok(())
+	}
+
+	fn finish(&mut self) -> Result<()> {
+		if !self.started {
+			self.start()?;
+		}
+		let moov = self.build_moov()?;
+		let mdat_size = self.position - self.mdat_start;
+		self.io.seek(self.mdat_start + 8)?;
+		self.io.write_all(&mdat_size.to_be_bytes())?;
+		self.io.seek(self.position)?;
+		self.io.write_all(&moov)?;
+		debug_assert!(mdat_size >= MDAT_HEADER_SIZE);
+		Ok(())
+	}
+}
