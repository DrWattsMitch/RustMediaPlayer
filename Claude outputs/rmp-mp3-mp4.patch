--- /mnt/user-data/uploads/RustMediaPlayer/src/io/buffered.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/io/buffered.rs	2026-11-02 17:07:58.787382589 -0700
@@ -0,0 +1,142 @@
+//! Buffered, position-tracking reader on top of any [`Io`] backend.
+//!
+//! Demuxers for frame-based formats (MP3) and box-based formats (MP4) need to
+//! peek ahead, skip and seek without issuing a tiny `read` call per field. This
+//! plays the role of FFmpeg's `AVIOContext` read buffer, in safe Rust.
+
+use crate::io::Io;
+use crate::message::{Message, Result};
+
+/// Default buffer capacity. Large enough to hold several maximum-size MPEG
+/// audio frames, small enough to be cheap per demuxer.
+const DEFAULT_CAPACITY: usize = 64 * 1024;
+
+/// Upper bound for a single `fill` request; protects against callers asking
+/// for absurd peek windows derived from corrupt input.
+const MAX_PEEK: usize = 4 * 1024 * 1024;
+
+pub struct BufferedReader {
+	io: Box<dyn Io>,
+	buf: Vec<u8>,
+	/// First unread byte in `buf`.
+	start: usize,
+	/// One past the last valid byte in `buf`.
+	end: usize,
+	/// Absolute stream position of `buf[0]`.
+	offset: u64,
+	eof: bool,
+}
+
+impl BufferedReader {
+	pub fn new(io: Box<dyn Io>) -> Self {
+		Self::with_capacity(io, DEFAULT_CAPACITY)
+	}
+
+	pub fn with_capacity(io: Box<dyn Io>, capacity: usize) -> Self {
+		Self { io, buf: vec![0; capacity.max(16)], start: 0, end: 0, offset: 0, eof: false }
+	}
+
+	/// Absolute position of the next byte that will be returned.
+	pub fn position(&self) -> u64 {
+		self.offset + self.start as u64
+	}
+
+	/// Total size of the underlying stream, when the backend knows it.
+	pub fn size(&self) -> Option<u64> {
+		self.io.size().ok()
+	}
+
+	/// Bytes currently buffered and not yet consumed.
+	pub fn buffered(&self) -> &[u8] {
+		&self.buf[self.start..self.end]
+	}
+
+	/// Ensures at least `want` bytes are buffered (fewer only at end of
+	/// stream) and returns the buffered window.
+	pub fn fill(&mut self, want: usize) -> Result<&[u8]> {
+		if want > MAX_PEEK {
+			return Err(Message::Other("read window too large"));
+		}
+		if self.end - self.start >= want || self.eof {
+			return Ok(self.buffered());
+		}
+		if want > self.buf.len() {
+			self.buf.resize(want, 0);
+		}
+		if self.start > 0 {
+			self.buf.copy_within(self.start..self.end, 0);
+			self.offset += self.start as u64;
+			self.end -= self.start;
+			self.start = 0;
+		}
+		while self.end < want {
+			let n = self.io.read(&mut self.buf[self.end..])?;
+			if n == 0 {
+				self.eof = true;
+				break;
+			}
+			self.end += n;
+		}
+		Ok(self.buffered())
+	}
+
+	/// Marks `n` buffered bytes as read. `n` is clamped to what is buffered.
+	pub fn consume(&mut self, n: usize) {
+		self.start += n.min(self.end - self.start);
+	}
+
+	/// Reads exactly `out.len()` bytes or fails with "unexpected end of file".
+	pub fn read_exact(&mut self, out: &mut [u8]) -> Result<()> {
+		let from_buf = out.len().min(self.end - self.start);
+		out[..from_buf].copy_from_slice(&self.buf[self.start..self.start + from_buf]);
+		self.start += from_buf;
+
+		let mut filled = from_buf;
+		if filled < out.len() {
+			// Buffer exhausted: drop the window so its origin tracks the stream.
+			self.offset = self.position();
+			self.start = 0;
+			self.end = 0;
+		}
+		while filled < out.len() {
+			// Large reads bypass the buffer to avoid a needless copy.
+			let n = self.io.read(&mut out[filled..])?;
+			if n == 0 {
+				self.eof = true;
+				return Err(Message::Container("unexpected end of file"));
+			}
+			filled += n;
+			// Keep `position()` correct: the buffer is empty, so move its origin.
+			self.offset += n as u64;
+		}
+		Ok(())
+	}
+
+	/// Reads exactly `len` bytes into a new vector.
+	pub fn read_vec(&mut self, len: usize) -> Result<Vec<u8>> {
+		let mut out = vec![0u8; len];
+		self.read_exact(&mut out)?;
+		Ok(out)
+	}
+
+	/// Moves to an absolute position. Seeks inside the buffered window are free.
+	pub fn seek(&mut self, position: u64) -> Result<()> {
+		if position >= self.offset && position <= self.offset + self.end as u64 {
+			// Within (or at the end of) the window: no I/O needed.
+			self.start = (position - self.offset) as usize;
+			return Ok(());
+		}
+		self.io.seek(position)?;
+		self.offset = position;
+		self.start = 0;
+		self.end = 0;
+		self.eof = false;
+		Ok(())
+	}
+
+	/// Skips `n` bytes forward.
+	pub fn skip(&mut self, n: u64) -> Result<()> {
+		let target = self.position().checked_add(n).ok_or(Message::Container("offset overflow"))?;
+		self.seek(target)
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/io/cursor.rs rmp/src/io/cursor.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/io/cursor.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/io/cursor.rs	2026-11-02 17:08:06.139383026 -0700
@@ -0,0 +1,84 @@
+//! Bounds-checked big-endian reader over an in-memory byte slice.
+//!
+//! Every read returns `Result`, so parsing untrusted headers (ID3 frames,
+//! MP4 boxes) can never index out of bounds or panic.
+
+use crate::message::{Message, Result};
+
+const EOD: Message = Message::Container("unexpected end of data");
+
+#[derive(Debug, Clone)]
+pub struct ByteCursor<'a> {
+	data: &'a [u8],
+	pos: usize,
+}
+
+impl<'a> ByteCursor<'a> {
+	pub fn new(data: &'a [u8]) -> Self {
+		Self { data, pos: 0 }
+	}
+
+	pub fn position(&self) -> usize {
+		self.pos
+	}
+
+	pub fn remaining(&self) -> usize {
+		self.data.len() - self.pos
+	}
+
+	pub fn is_empty(&self) -> bool {
+		self.remaining() == 0
+	}
+
+	/// The unread remainder of the slice.
+	pub fn rest(&self) -> &'a [u8] {
+		&self.data[self.pos..]
+	}
+
+	pub fn read_bytes(&mut self, n: usize) -> Result<&'a [u8]> {
+		let end = self.pos.checked_add(n).ok_or(EOD)?;
+		let bytes = self.data.get(self.pos..end).ok_or(EOD)?;
+		self.pos = end;
+		Ok(bytes)
+	}
+
+	pub fn read_array<const N: usize>(&mut self) -> Result<[u8; N]> {
+		let bytes = self.read_bytes(N)?;
+		let mut out = [0u8; N];
+		out.copy_from_slice(bytes);
+		Ok(out)
+	}
+
+	pub fn skip(&mut self, n: usize) -> Result<()> {
+		self.read_bytes(n).map(|_| ())
+	}
+
+	pub fn read_u8(&mut self) -> Result<u8> {
+		Ok(self.read_array::<1>()?[0])
+	}
+
+	pub fn read_u16(&mut self) -> Result<u16> {
+		Ok(u16::from_be_bytes(self.read_array()?))
+	}
+
+	pub fn read_u24(&mut self) -> Result<u32> {
+		let [a, b, c] = self.read_array()?;
+		Ok(u32::from_be_bytes([0, a, b, c]))
+	}
+
+	pub fn read_u32(&mut self) -> Result<u32> {
+		Ok(u32::from_be_bytes(self.read_array()?))
+	}
+
+	pub fn read_i32(&mut self) -> Result<i32> {
+		Ok(i32::from_be_bytes(self.read_array()?))
+	}
+
+	pub fn read_u64(&mut self) -> Result<u64> {
+		Ok(u64::from_be_bytes(self.read_array()?))
+	}
+
+	pub fn read_fourcc(&mut self) -> Result<[u8; 4]> {
+		self.read_array()
+	}
+}
diff -ruN '--exclude=target' /mnt/user-data/uploads/RustMediaPlayer/src/io/memory.rs rmp/src/io/memory.rs
--- /mnt/user-data/uploads/RustMediaPlayer/src/io/memory.rs	1969-12-31 17:00:00.000000000 -0700
+++ rmp/src/io/memory.rs	2026-11-02 17:08:11.779383361 -0700
@@ -0,0 +1,63 @@
+//! In-memory [`Io`] backend.
+//!
+//! Useful for tests and for muxing into a buffer. Clones share the same
+//! underlying bytes (but keep independent cursors), so a caller can hand one
+//! clone to a muxer and read the result back through another.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use crate::io::Io;
+use crate::message::{Message, Result};
+
+#[derive(Debug, Clone, Default)]
+pub struct MemoryIo {
+	data: Rc<RefCell<Vec<u8>>>,
+	pos: usize,
+}
+
+impl MemoryIo {
+	pub fn new() -> Self {
+		Self::default()
+	}
+
+	pub fn from_vec(data: Vec<u8>) -> Self {
+		Self { data: Rc::new(RefCell::new(data)), pos: 0 }
+	}
+
+	/// Copy of the current contents.
+	pub fn contents(&self) -> Vec<u8> {
+		self.data.borrow().clone()
+	}
+}
+
+impl Io for MemoryIo {
+	fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
+		let data = self.data.borrow();
+		let available = data.get(self.pos..).unwrap_or(&[]);
+		let n = available.len().min(buf.len());
+		buf[..n].copy_from_slice(&available[..n]);
+		self.pos += n;
+		Ok(n)
+	}
+
+	fn write(&mut self, buf: &[u8]) -> Result<usize> {
+		let mut data = self.data.borrow_mut();
+		let end = self.pos.checked_add(buf.len()).ok_or(Message::Other("write overflow"))?;
+		if end > data.len() {
+			data.resize(end, 0);
+		}
+		data[self.pos..end].copy_from_slice(buf);
+		self.pos = end;
+		Ok(buf.len())
+	}
+
+	fn seek(&mut self, pos: u64) -> Result<()> {
+		self.pos = usize::try_from(pos).map_err(|_| Message::Other("seek overflow"))?;
+		Ok(())
+	}
+
+	fn size(&self) -> Result<u64> {
+		Ok(self.data.borrow().len() as u64)
+	}
+}
